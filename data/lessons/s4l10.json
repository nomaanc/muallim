or=\"#0d9488\"/>\n      <stop offset=\"100%\" stop-color=\"#0284c7\"/>\n    </linearGradient>\n  </defs>\n  <rect x=\"8\" y=\"8\" width=\"744\" height=\"174\" rx=\"12\" fill=\"#0f172a\" stroke=\"#1e293b\" stroke-width=\"2\"/>\n  <rect x=\"22\" y=\"20\" width=\"150\" height=\"26\" rx=\"13\" fill=\"url(#u4grad)\"/>\n  <text x=\"97\" y=\"37\" fill=\"#ffffff\" font-size=\"12\" font-weight=\"700\" text-anchor=\"middle\" font-family=\"sans-serif\">UNIT 4 • LESSON 10</text>\n  <text x=\"188\" y=\"38\" fill=\"#f8fafc\" font-size=\"15\" font-weight=\"700\" font-family=\"sans-serif\">Zameer-e-Muttasil Mu'annas Ghaib: بَيْتٌ ← بَيْتُهَا (Page 24)</text>\n  <rect x=\"24\" y=\"58\" width=\"220\" height=\"68\" rx=\"10\" fill=\"#1e293b\" stroke=\"#475569\"/>\n  <text x=\"134\" y=\"98\" fill=\"#fbbf24\" font-size=\"24\" font-weight=\"700\" text-anchor=\"middle\" direction=\"rtl\" font-family=\"Traditional Arabic,Amiri,serif\">بَيْتٌ</text>\n  <circle cx=\"288\" cy=\"92\" r=\"22\" fill=\"#0d9488\"/>\n  <text x=\"288\" y=\"98\" fill=\"#ffffff\" font-size=\"15\" font-weight=\"700\" text-anchor=\"middle\" font-family=\"sans-serif\">Zameer (ـهَا)</text>\n  <rect x=\"332\" y=\"58\" width=\"402\" height=\"68\" rx=\"10\" fill=\"#0f292a\" stroke=\"#14b8a6\" stroke-width=\"1.5\"/>\n  <text x=\"533\" y=\"98\" fill=\"#34d399\" font-size=\"23\" font-weight=\"700\" text-anchor=\"middle\" direction=\"rtl\" font-family=\"Traditional Arabic,Amiri,serif\">بَيْتُهَا</text>\n  <text x=\"26\" y=\"150\" fill=\"#cbd5e1\" font-size=\"12.5\" font-family=\"sans-serif\">• بَيْتٌ (Ghar) se بَيْتُهَا (Us (mu'annas) ka ghar) banta hai.</text>\n  <text x=\"26\" y=\"170\" fill=\"#94a3b8\" font-size=\"12\" font-family=\"sans-serif\">• Qur'an Majeed mein yeh tarkeeb saikdon maqamaat par barah-e-raast samajh aati hai.</text>\n</svg>\n</div>\n**Qaa'ida (Page 24):** Kisi mu'annas ism ki taraf nisbat karne ('Us aurat ka / Us basti ka / Us nafs ka / Us zameen ka') ke liye ism ke aakhir mein **`ـهَا`** lagaya jata hai: `بَيْتٌ ← بَيْتُهَا`، `أَهْلُهَا` (us basti ke log), `أَصْلُهَا ثَابِتٌ وَفَرْعُهَا فِي السَّمَاءِ` (uski jad mazboot hai aur uski shaakh aasman mein hai)."}},{"id":"sec_s4l10_lbl1","type":"section_label","data":{"text":"Darj zail Quranic fiqron ka tarjuma khud kijiye:"}},{"id":"sec_s4l10_r2","type":"rule_paragraph","data":{"text":"Jab kisi ism (naam) ke aakhir mein 'ـهَا' (haa) zameer jodi jaati hai toh yeh wahid ghaib muannath (us ek aurat) ki milkiyat (uska / uski) batati hai. Jaise: بَيْتٌ (ghar) se بَيْتُهَا (uska ghar), رَبٌّ se رَبُّهَا (uska Rabb)."}},{"id":"sec_s4l10_s3","type":"two_col_numbered_list","data":{"is_numbered":false,"items":[{"id":"s4l10_s3_s1","arabic":"بَيْتٌ","arabic_markup":"<span class=\"arabic-root\">بَيْتٌ</span>","hinglish":"Ghar","translations":{"en":"A house","ur":"گھر","hi":"घर"},"displayOrder":1},{"id":"s4l10_s3_s2","arabic":"بَيْتُهَا","arabic_markup":"<span class=\"arabic-root\">بَيْتُ</span><span class=\"nonroot\">هَا</span>","hinglish":"Us (muannath) ka ghar","translations":{"en":"Her house","ur":"اس (عورت) کا گھر","hi":"उस (स्त्री) का घर"},"displayOrder":2},{"id":"s4l10_s3_s3","arabic":"رَبٌّ","arabic_markup":"<span class=\"arabic-root\">رَبٌّ</span>","hinglish":"Rabb","translations":{"en":"Lord","ur":"رب","hi":"रब"},"displayOrder":3},{"id":"s4l10_s3_s4","arabic":"رَبُّهَا","arabic_markup":"<span class=\"arabic-root\">رَبُّ</span><span class=\"nonroot\">هَا</span>","hinglish":"Us (muannath) ka Rabb","translations":{"en":"Her Lord","ur":"اس (عورت) کا رب","hi":"उस (स्त्री) का रब"},"displayOrder":4},{"id":"s4l10_s3_s5","arabic":"زَوْجٌ","arabic_markup":"<span class=\"arabic-root\">زَوْجٌ</span>","hinglish":"Shohar","translations":{"en":"A husband","ur":"شوہر","hi":"पति (शौहर)"},"displayOrder":5},{"id":"s4l10_s3_s6","arabic":"زَوْجُهَا","arabic_markup":"<span class=\"arabic-root\">زَوْجُ</span><span class=\"nonroot\">هَا</span>","hinglish":"Us (muannath) ka shohar","translations":{"en":"Her husband","ur":"اس (عورت) کا شوہر","hi":"उस