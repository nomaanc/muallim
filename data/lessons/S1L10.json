    {
      "id": "sec_s1l10_r2",
      "type": "rule_paragraph",
      "data": {
        "text": "Neeche diye gaye jama ke alfaaz samajhne mein asaan hain. Aap ki sahulat ke liye naye alfaaz ke wahid (singular) bhi saath mein zikr kiye gaye hain.",
        "content": "Neeche diye gaye jama ke alfaaz samajhne mein asaan hain. Aap ki sahulat ke liye naye alfaaz ke wahid (singular) bhi saath mein zikr kiye gaye hain.",
        "hinglish_text": "Neeche diye gaye jama ke alfaaz samajhne mein asaan hain. Aap ki sahulat ke liye naye alfaaz ke wahid (singular) bhi saath mein zikr kiye gaye hain."
      }
