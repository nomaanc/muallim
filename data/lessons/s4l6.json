rkup":"<span class=\"arabic-root\">جَيْبُ</span><span class=\"nonroot\">كَ</span>","hinglish":"Aapka girehbaan","translations":{"en":"Your bosom","ur":"آپ کا گریبان","hi":"आपका गिरेबान"},"displayOrder":17},{"id":"s4l6_g2_w22","arabic":"سُبْحَانَكَ","arabic_markup":"<span class=\"arabic-root\">سُبْحَانَ</span><span class=\"nonroot\">كَ</span>","hinglish":"Teri paaki","translations":{"en":"Exalted are You","ur":"تیری پاکی","hi":"तेरी पाकी"},"displayOrder":18},{"id":"s4l6_g2_w7","arabic":"ظَهْرُكَ","arabic_markup":"<span class=\"arabic-root\">ظَهْرُ</span><span class=\"nonroot\">كَ</span>","hinglish":"Teri peeth","translations":{"en":"Your back","ur":"تیری پیٹھ","hi":"तेरी पीठ"},"displayOrder":19},{"id":"s4l6_g2_w15","arabic":"يَدُكَ","arabic_markup":"<span class=\"arabic-root\">يَدُ</span><span class=\"nonroot\">كَ</span>","hinglish":"Aapka hath","translations":{"en":"Your hand","ur":"آپ کا ہاتھ","hi":"आपका हाथ"},"displayOrder":20},{"id":"s4l6_g2_w23","arabic":"يَمِينُكَ","arabic_markup":"<span class=\"arabic-root\">يَمِينُ</span><span class=\"nonroot\">كَ</span>","hinglish":"Tera daayan hath","translations":{"en":"Your right hand","ur":"تیرا دایاں ہاتھ","hi":"तेरा दायाँ हाथ"},"displayOrder":21},{"id":"s4l6_g2_w8","arabic":"عِنْدَكَ","arabic_markup":"<span class=\"arabic-root\">عِنْدَ</span><span class=\"nonroot\">كَ</span>","hinglish":"Tere paas","translations":{"en":"With you","ur":"تیرے پاس","hi":"तेरे पास"},"displayOrder":22},{"id":"s4l6_g2_w16","arabic":"بَصَرُكَ","arabic_markup":"<span class=\"arabic-root\">بَصَرُ</span><span class=\"nonroot\">كَ</span>","hinglish":"Aapki nazar","translations":{"en":"Your sight","ur":"آپ کی نظر","hi":"आपकी नज़र"},"displayOrder":23},{"id":"s4l6_g2_w24","arabic":"وَعْدُكَ","arabic_markup":"<span class=\"arabic-root\">وَعْدُ</span><span class=\"nonroot\">كَ</span>","hinglish":"Tera wada","translations":{"en":"Your promise","ur":"تیرا وعدہ","hi":"तेरा वादा"},"displayOrder":24}],"cols":3}},{"id":"sec_s4l6_s3","type":"two_col_numbered_list","data":{"is_numbered":true,"items":[{"id":"s4l6_s3_s1","sentence_number":1,"arabic":"وَرَبُّكَ عَلَى كُلِّ شَيْءٍ حَفِيظٌ","arabic_markup":"<span class=\"arabic-root\">وَرَبُّكَ عَلَى كُلِّ شَيْءٍ حَفِيظٌ</span>","hinglish":"Aur aapka Rabb har cheez par nigehbaan hai","translations":{"en":"And your Lord is Guardian over all things","ur":"اور آپ کا رب ہر چیز پر نگہبان ہے","hi":"और आपका रब हर चीज़ पर निगेहबान है"},"ref":"34:21"},{"id":"s4l6_s3_s2","sentence_number":2,"arabic":"حَسْبُكَ اللَّهُ","arabic_markup":"<span class=\"arabic-root\">حَسْبُ</span><span class=\"nonroot\">كَ</span> <span class=\"arabic-root\">اللَّهُ</span>","hinglish":"Tujh ko Allah kafi hai","translations":{"en":"Sufficient for you is Allah","ur":"تجھ کو اللہ کافی ہے","hi":"तुझ को अल्लाह काफ़ी है"}},{"id":"s4l6_s3_s3","sentence_number":3,"arabic":"وَكَانَ رَبُّكَ قَدِيرًا","arabic_markup":"<span class=\"arabic-root\">وَكَانَ رَبُّ</span><span class=\"nonroot\">كَ</span> <span class=\"arabic-root\">قَدِيرًا</span>","hinglish":"Aur aapka Rabb qadir hai","translations":{"en":"And ever is your Lord competent","ur":"اور آپ کا رب قادر ہے","hi":"और आपका रब क़ादिर है"},"ref":"25:54"},{"id":"s4l6_s3_s4","sentence_number":4,"arabic":"وَكَانَ رَبُّكَ بَصِيرًا","arabic_markup":"<span class=\"arabic-root\">وَكَانَ رَبُّ</span><span class=\"nonroot\">كَ</span> <span class=\"arabic-root\">بَصِيرًا</span>","hinglish":"Aur aapka Rabb dekhne wala hai","translations":{"en":"And ever is your Lord Seeing","ur":"اور آپ کا رب دیکھنے والا ہے","hi":"और आपका रब देखने वाला है"},"ref":"25:20"},{"id":"s4l6_s3_s5","sentence_number":5,"arabic":"فَبَصَرُكَ / الْيَوْمَ / حَدِيدٌ","arabic_markup":"<span class=\"arabic-root\">فَبَصَرُكَ</span> / <span class=\"nonroot\">الْيَوْمَ</span> / <span class=\"arabic-root\">حَدِيدٌ</span>","hinglish":"Toh aapki nazar aaj sakht tez hai","translations":{"en":"So your sight, this Day, is sharp","ur":"تو آپ کی نظر آج سخت تیز ہے","hi":"तो आपकी नज़र आज सख़्त तेज़ है"},"ref":"50:22"},{"id":"s4l6_s3_s6","sentence_number":6,"arabic":"وَرَبُّكَ الْغَفُورُ / ذُو الرَّحْمَةِ","arabic_markup":"<span class=\"arabic-root\">وَرَبُّكَ الْغَفُورُ / ذُو الرَّحْمَةِ</span>","hinglish":"Aur aapka Rabb bohot bakhshne wala hai rahmat wala","translations":{"en":"And your Lord is the Forgiving, full of mercy","ur":"اور آپ کا رب بہت بخشنے والا ہے رحمت والا","hi":"और आपका रब बहुत बख़्शने वाला है रहमत वाला"},"ref":"18:58"},{"id":"s4l6_s3_s7","sentence_number":7,"arabic":"وَرَبُّكَ الْغَنِيُّ / ذُو الرَّحْمَةِ","arabic_markup":"<span class=\"arabic-root\">وَرَبُّكَ الْغَنِيُّ / ذُو الرَّحْمَةِ</span>","hinglish":"Aur aapka Rabb beniyaaz hai rahmat wala","translations":{"en":"And your Lord is the Free of need, possessor of mercy","ur":"اور آپ کا رب بے نیاز ہے رحمت والا","hi":"और आपका रब बेनियाज़ है रहमत वाला"},"ref":"6:133"},{"id":"s4l6_s3_s8","sentence_number":8,"arabic":"وَرَبُّكَ أَعْلَمُ / بِمَنْ / فِي السَّمَاوَاتِ وَالْأَرْضِ","arabic_markup":"<span class=\"arabic-root\">وَرَبُّكَ أَعْلَمُ / بِمَنْ / فِي السَّمَاوَاتِ وَالْأَرْضِ</span>","hinglish":"Aur aapka Rabb zyada jaanne wala hai usko jo aasmanon aur zameen mein hain","translations":{"en":"And your Lord is most knowing of whoever is in the heavens and the earth","ur":"اور آپ کا رب زیادہ جاننے والا ہے اس کو جو آسمانوں اور زمین میں ہیں","hi":"और आपका रब ज़्यादा जानने वाला है उसको जो आसमानों और ज़मीन में हैं"},"ref":"17:55"}]}}]}}