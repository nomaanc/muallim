nslations":{"en":"Allah is our Lord","ur":"اللہ ہمارا رب ہے","hi":"अल्लाह हमारा रब है"},"arabic_markup":"<span class=\"arabic-root\">اللَّهُ</span> <span class=\"arabic-root\">رَبُّ</span><span class=\"nonroot\">نَا</span>"},{"id":"s5l14_s_2","arabic":"اللَّهُ رَبُّنَا وَرَبُّكُمْ","hinglish":"Allah hamara Rabb aur tumhara Rabb hai","sentence_number":2,"translations":{"en":"Allah is our Lord and your Lord","ur":"اللہ ہمارا رب اور تمہارا رب ہے","hi":"अल्लाह हमारा रब और तुम्हारा रब है"},"arabic_markup":"<span class=\"arabic-root\">اللَّهُ</span> <span class=\"arabic-root\">رَبُّ</span><span class=\"nonroot\">نَا</span> <span class=\"arabic-root\">وَرَبُّكُمْ</span>","ref":"42:15"},{"id":"s5l14_s_3","arabic":"رَبُّنَا اللَّهُ","hinglish":"hamara Rabb Allah hai","sentence_number":3,"translations":{"en":"Our Lord is Allah","ur":"ہمارا رب اللہ ہے","hi":"हमारा रब अल्लाह है"},"arabic_markup":"<span class=\"arabic-root\">رَبُّ</span><span class=\"nonroot\">نَا</span> <span class=\"arabic-root\">اللَّهُ</span>"},{"id":"s5l14_s_4","arabic":"وَرَبُّنَا الرَّحْمَٰنُ","hinglish":"aur hamara Rabb Rahman hai","sentence_number":4,"translations":{"en":"And our Lord is the Most Merciful","ur":"اور ہمارا رب رحمن ہے","hi":"और हमारा रब रहमान है"},"arabic_markup":"<span class=\"arabic-root\">وَرَبُّ</span><span class=\"nonroot\">نَا</span> <span class=\"arabic-root\">الرَّحْمَٰنُ</span>","ref":"21:112"},{"id":"s5l14_s_5","arabic":"وَهُوَ رَبُّنَا وَرَبُّكُمْ","hinglish":"aur woh hamara Rabb aur tumhara Rabb hai","sentence_number":5,"translations":{"en":"And He is our Lord and your Lord","ur":"اور وہ ہمارا رب اور تمہارا رب ہے","hi":"और वह हमारा रब और तुम्हारा रब है"},"arabic_markup":"<span class=\"arabic-root\">وَهُوَ</span> <span class=\"arabic-root\">رَبُّ</span><span class=\"nonroot\">نَا</span> <span class=\"arabic-root\">وَرَبُّكُمْ</span>","ref":"2:139"},{"id":"s5l14_s_6","arabic":"وَهُوَ رَبُّنَا","hinglish":"aur woh hamara Rabb hai","sentence_number":6,"translations":{"en":"And He is our Lord","ur":"اور وہ ہمارا رب ہے","hi":"और वह हमारा रब है"},"arabic_markup":"<span class=\"arabic-root\">وَهُوَ</span> <span class=\"arabic-root\">رَبُّ</span><span class=\"nonroot\">نَا</span>","ref":"2:139"},{"id":"s5l14_s_7","arabic":"أَنْتَ وَلِيُّنَا","hinglish":"tu hamara dost hai","sentence_number":7,"translations":{"en":"You are our protector","ur":"آپ ہمارے ولی (مددگار) ہیں","hi":"आप हमारे वली (मददगार) हैं"},"arabic_markup":"<span class=\"arabic-root\">أَنْتَ</span> <span class=\"arabic-root\">وَلِيُّ</span><span class=\"nonroot\">نَا</span>"},{"id":"s5l14_s_8","arabic":"هُوَ مَوْلَانَا","hinglish":"woh hamara maula hai","sentence_number":8,"translations":{"en":"He is our protector","ur":"وہ ہمارا مولیٰ (کارساز) ہے","hi":"वह हमारा मौला (कारसाज़) है"},"arabic_markup":"<span class=\"arabic-root\">هُوَ</span> <span class=\"arabic-root\">مَوْلَا</span><span class=\"nonroot\">نَا</span>","ref":"9:51"},{"id":"s5l14_s_9","arabic":"حَسْبُنَا اللَّهُ","hinglish":"hamare liye Allah kafi hai","sentence_number":9,"translations":{"en":"Sufficient for us is Allah","ur":"ہمارے لیے اللہ کافی ہے","hi":"हमारे लिए अल्लाह काफ़ी है"},"arabic_markup":"<span class=\"arabic-root\">حَسْبُ</span><span class=\"nonroot\">نَا</span> <span class=\"arabic-root\">اللَّهُ</span>"},{"id":"s5l14_s_10","arabic":"سُبْحَانَكَ / أَنْتَ وَلِيُّنَا","hinglish":"tu pak hai tu hamara dost hai","sentence_number":10,"translations":{"en":"Exalted are You; You are our protector","ur":"آپ پاک ہیں، آپ ہمارے ولی (مددگار) ہیں","hi":"आप पाक हैं, आप हमारे वली (मददगार) हैं"},"arabic_markup":"<span class=\"arabic-root\">سُبْحَانَكَ</span> / <span class=\"arabic-root\">أَنْتَ</span> <span class=\"arabic-root\">وَلِيُّ</span><span class=\"nonroot\">نَا</span>","ref":"34:41"},{"id":"s5l14_s_11","arabic":"هَٰذَا كِتَابُنَا","hinglish":"yeh hamari kitab hai","sentence_number":11,"translations":{"en":"This is Our record (book)","ur":"یہ ہماری کتاب ہے","hi":"यह हमारी किताब है"},"arabic_markup":"<span class=\"arabic-root\">هَٰذَا</span> <span class=\"arabic-root\">كِتَابُ</span><span class=\"nonroot\">نَا</span>","ref":"45:29"},{"id":"s5l14_s_12","arabic":"هَٰذَا عَطَاؤُنَا","hinglish":"yeh hamari ata hai","sentence_number":12,"translations":{"en":"This is Our gift","ur":"یہ ہماری عطا ہے","hi":"यह हमारी अता है"},"arabic_markup":"<span class=\"arabic-root\">هَٰذَا</span> <span class=\"arabic-root\">عَطَاؤُ</span><span class=\"nonroot\">نَا</span>","ref":"38:39"},{"id":"s5l14_s_13","arabic":"وَتِلْكَ حُجَّتُنَا","hinglish":"aur woh hamari daleel hai","sentence_number":13,"translations":{"en":"And that was Our argument","ur":"اور وہ ہماری دلیل ہے","hi":"और वह हमारी दलील है"},"arabic_markup":"<span class=\"arabic-root\">وَتِلْكَ</span> <span class=\"arabic-root\">حُجَّتُ</span><span class=\"nonroot\">نَا</span>","ref":"6:83"},{"id":"s5l14_s_14","arabic":"إِنَّ هَٰذَا لَرِزْقُنَا","hinglish":"beshak yeh hamara rizq hai","sentence_number":14,"translations":{"en":"Indeed, this is Our provision","ur":"بیشک یہ ہمارا رزق ہے","hi":"बेशक यह हमारा रिज़्क़ है"},"arabic_markup":"<span class=\"arabic-root\">إِنَّ</span> <span class=\"arabic-root\">هَٰذَا</span> <span class=\"arabic-root\">لَرِزْقُ</span><span class=\"nonroot\">نَا</span>","ref":"38:54"},{"id":"s5l14_s_15","arabic":"وَأَبُونَا شَيْخٌ كَبِيرٌ","hinglish":"aur hamare baap bade buzurg hain","translations":{"en":"And our father is an eminent old man","ur":"اور ہمارے والد بڑے بزرگ (بوڑھے) ہیں","hi":"और हमारे पिता बड़े बुज़ुर्ग (बूढ़े) हैं"},"arabic_markup":"<span class=\"arabic-root\">وَأَبُو</span><span class=\"nonroot\">نَا</span> <span class=\"arabic-root\">شَيْخٌ</span> <span class=\"arabic-root\">كَبِيرٌ</span>","sentence_number":15,"ref":"28:23"},{"id":"s5l14_s_16","arabic":"قُلُوبُنَا غُلْفٌ","hinglish":"hamare dil lipe hue hain","translations":{"en":"Our hearts are wrapped","ur":"ہمارے دل غلاف میں ہیں (پردے میں لپٹے ہیں)","hi":"हमारे दिल पर्दे में लिपटे हैं (ग़िलाफ़ में हैं)"},"arabic_markup":"<span class=\"arabic-root\">قُلُوبُ</span><span class=\"nonroot\">نَا</span> <span class=\"arabic-root\">غُلْفٌ</span>","sentence_number":16},{"id":"s5l14_s_17","arabic":"أَنْتَ وَلِيُّنَا مِنْ دُونِهِمْ","hinglish":"tu hamara dost hai un ko chhod kar","translations":{"en":"You are our protector rather than them","ur":"آپ ان کو چھوڑ کر ہمارے ولی (مددگار) ہیں","hi":"आप उनको छोड़कर हमारे वली (मददगार) हैं"},"arabic_markup":"<span class=\"arabic-root\">أَنْتَ</span> <span class=\"arabic-root\">وَلِيُّ</span><span class=\"nonroot\">نَا</span> <span class=\"nonroot\">مِنْ</span> <span class=\"arabic-root\">دُونِهِمْ</span>","sentence_number":17,"ref":"34:41"},{"id":"s5l14_s_18","arabic":"رَبُّنَا رَبُّ السَّمَاوَاتِ وَالْأَرْضِ","hinglish":"hamara Rabb aasmano aur zameen ka Rabb hai","translations":{"en":"Our Lord is the Lord of the heavens and the earth","ur":"ہمارا رب آسمانوں اور زمین کا رب ہے","hi":"हमारा रब आसमानों और ज़मीन का रब है"},"arabic_markup":"<span class=\"arabic-root\">رَبُّ</span><span class=\"nonroot\">نَا</span> <span class=\"arabic-root\">رَبُّ</span> <span class=\"arabic-root\">السَّمَاوَاتِ</span> <span class=\"arabic-root\">وَالْأَرْضِ</span>","sentence_number":18,"ref":"18:14"},{"id":"s5l14_s_19","arabic":"أَ آلِهَتُنَا خَيْرٌ / أَمْ هُوَ","hinglish":"kya hamare ma'bud behtar hain ya woh","translations":{"en":"Are our gods better, or is he?","ur":"کیا ہمارے معبود بہتر ہیں یا وہ؟","hi":"क्या हमारे माबूद बेहतर हैं या वह?"},"arabic_markup":"<span class=\"arabic-root\">أَ</span> <span class=\"arabic-root\">آلِهَتُ</span><span class=\"nonroot\">نَا</span> <span class=\"arabic-root\">خَيْرٌ</span> / <span class=\"arabic-root\">أَمْ</span> <span class=\"arabic-root\">هُوَ</span>","sentence_number":19,"ref":"43:58"},{"id":"s5l14_s_20","arabic":"لَشَهَادَتُنَا أَحَقُّ مِنْ شَهَادَتِهِمَا","hinglish":"hamari gawahi zyada haqdar hai un dono ki gawahi se","translations":{"en":"Our testimony is truer than the testimony of both of them","ur":"ہماری گواہی ان دونوں کی گواہی سے زیادہ سچی (حقدار) ہے","hi":"हमारी गवाही उन दोनों की गवाही से ज़्यादा हक़दार (सच्ची) है"},"arabic_markup":"<span class=\"arabic-root\">لَشَهَادَتُ</span><span class=\"nonroot\">نَا</span> <span class=\"arabic-root\">أَحَقُّ</span> <span class=\"nonroot\">مِنْ</span> <span class=\"arabic-root\">شَهَادَتِهِمَا</span>","sentence_number":20,"ref":"5:107"},{"id":"s5l14_s_21","arabic":"إِنَّ اللَّهَ مَعَنَا","hinglish":"beshak Allah hamare saath hai","translations":{"en":"Indeed, Allah is with us","ur":"بیشک اللہ ہمارے ساتھ ہے","hi":"बेशक अल्लाह हमारे साथ है"},"arabic_markup":"<span class=\"arabic-root\">إِنَّ</span> <span class=\"arabic-root\">اللَّهَ</span> <span class=\"arabic-root\">مَعَ</span><span class=\"nonroot\">نَا</span>","sentence_number":21,"ref":"9:40"},{"id":"s5l14_s_22","arabic":"لَا حُجَّةَ بَيْنَنَا وَبَيْنَكُمُ","hinglish":"koi daleel nahin hamare darmiyan aur tumhare darmiyan","translations":{"en":"There is no dispute between us and you","ur":"ہمارے اور تمہارے درمیان کوئی بحث (جھگڑا) نہیں","hi":"हमारे और तुम्हारे दरमियान कोई बहस (झगड़ा) नहीं"},"arabic_markup":"<span class=\"arabic-root\">لَا</span> <span class=\"arabic-root\">حُجَّةَ</span> <span class=\"arabic-root\">بَيْنَ</span><span class=\"nonroot\">نَا</span> <span class=\"arabic-root\">وَبَيْنَكُمُ</span>","sentence_number":22,"ref":"42:15"},{"id":"s5l14_s_23","arabic":"وَلَدَيْنَا كِتَابٌ","hinglish":"aur hamare paas kitab hai","translations":{"en":"And with Us is a record (book)","ur":"اور ہمارے پاس ایک کتاب ہے","hi":"और हमारे पास एक किताब है"},"arabic_markup":"<span class=\"arabic-root\">وَلَدَيْ</span><span class=\"nonroot\">نَا</span> <span class=\"arabic-root\">كِتَابٌ</span>","sentence_number":23,"ref":"23:62"},{"id":"s5l14_s_24","arabic":"وَعِنْدَنَا كِتَابٌ حَفِيظٌ","hinglish":"aur hamare paas hifazat karne wali kitab hai","translations":{"en":"And with Us is a retaining record","ur":"اور ہمارے پاس حفاظت کرنے والی کتاب ہے","hi":"और हमारे पास हिफ़ाज़त करने वाली किताब है"},"arabic_markup":"<span class=\"arabic-root\">وَعِنْدَ</span><span class=\"nonroot\">نَا</span> <span class=\"arabic-root\">كِتَابٌ</span> <span class=\"arabic-root\">حَفِيظٌ</span>","sentence_number":24,"ref":"50:4"},{"id":"s5l14_s_25","arabic":"فَإِذَا هُمْ جَمِيعٌ لَّدَيْنَا مُحْضَرُونَ","hinglish":"toh tab woh sab hamare paas hazir kiye gaye","translations":{"en":"Then at once they will all be brought before Us","ur":"تو اچانک وہ سب کے سب ہمارے سامنے حاضر کیے جائیں گے","hi":"तो अचानक वह सब के सब हमारे सामने हाज़िर किए जाएँगे"},"arabic_markup":"<span class=\"arabic-root\">فَإِذَا</span> <span class=\"arabic-root\">هُمْ</span> <span class=\"arabic-root\">جَمِيعٌ</span> <span class=\"arabic-root\">لَّدَيْ</span><span class=\"nonroot\">نَا</span> <span class=\"arabic-root\">مُحْضَرُونَ</span>","sentence_number":25,"ref":"36:53"},{"id":"s5l14_s_26","arabic":"وَإِلَهُنَا وَإِلَهُكُمْ وَاحِدٌ / وَنَحْنُ لَهُ مُسْلِمُونَ","hinglish":"aur hamara ma'bud aur tumhara ma'bud ek hai aur ham us ke liye farmabardar hain","translations":{"en":"And our God and your God is one; and we are Muslims [in submission] to Him","ur":"اور ہمارا معبود اور تمہارا معبود ایک ہی ہے، اور ہم اسی کے فرمانبردار ہیں","hi":"और हमारा माबूद और तुम्हारा माबूद एक ही है, और हम उसी के फ़रमाँबरदार हैं"},"arabic_markup":"<span class=\"arabic-root\">وَإِلَهُ</span><span class=\"nonroot\">نَا</span> <span class=\"arabic-root\">وَإِلَهُكُمْ</span> <span class=\"arabic-root\">وَاحِدٌ</span> / <span class=\"arabic-root\">وَنَحْنُ</span> <span class=\"arabic-root\">لَهُ</span> <span class=\"arabic-root\">مُسْلِمُونَ</span>","sentence_number":26,"ref":"29:46"}],"is_numbered":true}}]}}