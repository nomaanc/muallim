نصیحت سے","hi":"निशानियों और नसीहत से"},"ref":"3:58"},{"id":"s2l5_g9_w11","arabic":"مِنَ الْأَمْوَالِ وَالْأَنفُسِ","arabic_markup":"<span class=\"nonroot\">مِنَ</span> <span class=\"arabic-root\">الْأَمْوَالِ</span> <span class=\"nonroot\">وَ</span><span class=\"arabic-root\">الْأَنفُسِ</span>","hinglish":"Maalo aur jaano se","translations":{"en":"From wealth and lives","ur":"مالوں اور جانوں سے","hi":"मालों और जानों से"},"ref":"2:155"}]}},{"id":"sec_s2l5_r10","type":"rule_paragraph","data":{"text":"Agar (مِنْ) ke baad wala lafz (ال) ke baghair ho, toh maani mein 'koi' ya 'ek' ka izaafa hota hai. Pehli misaal dekh kar baaqi Quranic fiqron ka tarjuma khud karo."}},{"id":"sec_s2l5_g11","type":"two_col_numbered_list","data":{"is_numbered":false,"items":[{"id":"s2l5_g11_w1","arabic":"مِنْ عَهْدٍ","arabic_markup":"<span class=\"nonroot\">مِنْ</span> <span class=\"arabic-root\">عَهْد</span><span class=\"nonroot\">ٍ</span>","hinglish":"Kisi waade se","translations":{"en":"From any covenant / promise","ur":"کسی وعدے سے","hi":"किसी वादे से"}},{"id":"s2l5_g11_w2","arabic":"مِنْ مَاءٍ","arabic_markup":"<span class=\"nonroot\">مِنْ</span> <span class=\"arabic-root\">مَاء</span><span class=\"nonroot\">ٍ</span>","hinglish":"Kisi paani se","translations":{"en":"From any water","ur":"کسی پانی سے","hi":"किसी पानी से"}},{"id":"s2l5_g11_w3","arabic":"مِنْ كِتَابٍ","arabic_markup":"<span class=\"nonroot\">مِنْ</span> <span class=\"arabic-root\">كِتَاب</span><span class=\"nonroot\">ٍ</span>","hinglish":"Kisi kitaab se","translations":{"en":"From any book","ur":"کسی کتاب سے","hi":"किसी किताब से"}},{"id":"s2l5_g11_w4","arabic":"مِنْ نَارٍ","arabic_markup":"<span class=\"nonroot\">مِنْ</span> <span class=\"arabic-root\">نَار</span><span class=\"nonroot\">ٍ</span>","hinglish":"Kisi aag se","translations":{"en":"From any fire","ur":"کسی آگ سے","hi":"किसी आग से"}},{"id":"s2l5_g11_w5","arabic":"مِنْ عَدُوٍّ","arabic_markup":"<span class=\"nonroot\">مِنْ</span> <span class=\"arabic-root\">عَدُوٍ</span><span class=\"nonroot\">ّ</span>","hinglish":"Kisi dushman se","translations":{"en":"From any enemy","ur":"کسی دشمن سے","hi":"किसी दुश्मन से"}},{"id":"s2l5_g11_w6","arabic":"مِنْ مُشْرِكَةٍ","arabic_markup":"<span class=\"nonroot\">مِنْ</span> <span class=\"arabic-root\">مُشْرِكَة</span><span class=\"nonroot\">ٍ</span>","hinglish":"Kisi mushrik aurat se","translations":{"en":"From any polytheist woman","ur":"کسی مشرک عورت سے","hi":"किसी मुशरिक औरत से"}},{"id":"s2l5_g11_w7","arabic":"مِنْ مُشْرِكٍ","arabic_markup":"<span class=\"nonroot\">مِنْ</span> <span class=\"arabic-root\">مُشْرِك</span><span class=\"nonroot\">ٍ</span>","hinglish":"Kisi mushrik se","translations":{"en":"From any polytheist","ur":"کسی مشرک سے","hi":"किसी मुशरिक से"}},{"id":"s2l5_g11_w8","arabic":"مِنْ خَوْفٍ","arabic_markup":"<span class=\"nonroot\">مِنْ</span> <span class=\"arabic-root\">خَوْف</span><span class=\"nonroot\">ٍ</span>","hinglish":"Kisi khauf se","translations":{"en":"From any fear","ur":"کسی خوف سے","hi":"किसी ख़ौफ़ से"}},{"id":"s2l5_g11_w9","arabic":"مِنْ مَسَدٍ","arabic_markup":"<span class=\"nonroot\">مِنْ</span> <span class=\"arabic-root\">مَسَد</span><span class=\"nonroot\">ٍ</span>","hinglish":"Kisi khajoor ki chhaal se","translations":{"en":"From palm-fiber","ur":"کسی کھجور کی چھال سے","hi":"किसी खजूर की छाल से"}},{"id":"s2l5_g11_w10","arabic":"مِنْ جُوعٍ","arabic_markup":"<span class=\"nonroot\">مِنْ</span> <span class=\"arabic-root\">جُوع</span><span class=\"nonroot\">ٍ</span>","hinglish":"Kisi bhook se","translations":{"en":"From any hunger","ur":"کسی بھوک سے","hi":"किसी भूख से"}},{"id":"s2l5_g11_w11","arabic":"مِنْ أَجْرٍ","arabic_markup":"<span class=\"nonroot\">مِنْ</span> <span class=\"arabic-root\">أَجْر</span><span class=\"nonroot\">ٍ</span>","hinglish":"Kisi ajr se","translations":{"en":"From any reward","ur":"کسی اجر سے","hi":"किसी अज्र से"}},{"id":"s2l5_g11_w12","arabic":"مِنْ طِينٍ","arabic_markup":"<span class=\"nonroot\">مِنْ</span> <span class=\"arabic-root\">طِين</span><span class=\"nonroot\">ٍ</span>","hinglish":"Kisi mitti se","translations":{"en":"From any clay / mud","ur":"کسی مٹی سے","hi":"किसी मिट्टी से"}}],"cols":4}},{"id":"sec_s2l5_g12","type":"grace_box","data":{"text":"Allah ke fazl se, ab aap in Qur'ani aayaton ko khud samajh aur tarjuma kar sakte hain."}},{"id":"sec_s2l5_v13","type":"two_col_numbered_list","data":{"is_numbered":true,"items":[{"id":"s2l5_v13_s1","sentence_number":1,"arabic":"﴿وَالْفِتْنَةُ أَكْبَرُ مِنَ الْقَتْلِ﴾","arabic_markup":"﴿<span class=\"nonroot\">وَالْ</span><span class=\"arabic-root\">فِتْنَةُ</span> <span class=\"arabic-root\">أَكْبَرُ</span> <span class=\"nonroot\">مِنَ</span> <span class=\"nonroot\">الْ</span><span class=\"arabic-root\">قَتْلِ</span>﴾","hinglish":"Aur fitna qatl se bada hai.","translations":{"ur":"اور فتنہ قتل سے بڑا ہے","en":"And persecution is worse than killing","hi":"और फ़ितना क़त्ल से बड़ा है"},"ref":"2:217"},{"id":"s2l5_v13_s2","sentence_number":2,"arabic":"﴿وَالْفِتْنَةُ أَشَدُّ مِنَ الْقَتْلِ﴾","arabic_markup":"﴿<span class=\"arabic-root\">وَالْفِتْنَةُ أَشَدُّ </span><span class=\"nonroot\">مِنَ الْقَتْلِ</span>﴾","hinglish":"Aur fitna qatl se zyada sakht hai.","translations":{"en":"And fitnah (discord / persecution) is worse than killing.","ur":"اور فتنہ قتل سے زیادہ سخت ہے۔","hi":"और फ़ितना क़त्ल से ज़्यादा सख्त है।"},"ref":"2:191"}]}},{"id":"sec_s2l5_lbl14","type":"section_label","data":{"text":"Exercise"}},{"id":"sec_s2l5_r15","type":"rule_paragraph","data":{"text":"Q-1: mein Quranic aayaton mein se us hisse ko pehchano jahan (مِنْ) aur uske baad wala lafz mil kar murakkab bante hain:"}},{"id":"sec_s2l5_v16","type":"two_col_numbered_list","data":{"is_numbered":true,"items":[{"id":"s2l5_v16_s1","sentence_number":1,"arabic":"﴿وَمَا هُوَ بِمُزَحْزِحِهِ مِنَ الْعَذَابِ﴾","arabic_markup":"﴿<span class=\"arabic-root\">وَمَا هُوَ بِمُزَحْزِحِهِ </span><span class=\"nonroot\">مِنَ الْعَذَابِ</span>﴾","hinglish":"Aur woh use azaab se door karne wala nahi.","translations":{"en":"And it will not remove him from the punishment.","ur":"اور وہ اسے عذاب سے دور کرنے والا نہیں۔","hi":"और वह उसे अज़ाब से दूर करने वाला नहीं।"},"ref":"2:96"},{"id":"s2l5_v16_s2","sentence_number":2,"arabic":"﴿مَا أَنزَلَ اللهُ مِنَ الْكِتَابِ﴾","arabic_markup":"﴿<span class=\"arabic-root\">مَا أَنزَلَ اللهُ </span><span class=\"nonroot\">مِنَ الْكِتَابِ</span>﴾","hinglish":"Jo kuch Allah ne kitaab se naazil farmaya.","translations":{"en":"What Allah has revealed of the Book.","ur":"جو کچھ اللہ نے کتاب میں سے نازل فرمایا۔","hi":"जो कुछ अल्लाह ने किताब से नाज़िल फ़रमाया।"},"ref":"2:174"},{"id":"s2l5_v16_s3","sentence_number":3,"arabic":"﴿أَوْ كَصَيِّبٍ مِنَ السَّمَاءِ﴾","arabic_markup":"﴿<span class=\"arabic-root\">أَوْ كَصَيِّبٍ </span><span class=\"nonroot\">مِنَ السَّمَاءِ</span>﴾","hinglish":"Ya jaise aasmaan se tez baarish.","translations":{"en":"Or like a rainstorm from the sky.","ur":"یا جیسے آسمان سے تیز بارش۔","hi":"या जैसे आसमान से तेज़ बारिश।"},"ref":"2:19"},{"id":"s2l5_v16_s4","sentence_number":4,"arabic":"﴿وَمِنَ النَّاسِ مَنْ يَشْرِي نَفْسَهُ﴾","arabic_markup":"﴿<span class=\"nonroot\">وَمِنَ النَّاسِ</span> <span class=\"arabic-root\">مَنْ يَشْرِي نَفْسَهُ</span>﴾","hinglish":"Aur logon mein se koi apni jaan bech daalta hai.","translations":{"en":"And of the people is he who sells himself.","ur":"اور لوگوں میں سے کوئی اپنی جان بیچ ڈالتا ہے۔","hi":"और लोगों में से कोई अपनी जान बेच डालता है।"},"ref":"2:207"},{"id":"s2l5_v16_s5","sentence_number":5,"arabic":"﴿وَلَنَبْلُوَنَّكُمْ بِشَيْءٍ مِنَ الْخَوْفِ﴾","arabic_markup":"﴿<span class=\"arabic-root\">وَلَنَبْلُوَنَّكُمْ بِشَيْءٍ </span><span class=\"nonroot\">مِنَ الْخَوْفِ</span>﴾","hinglish":"Aur hum zaroor tumhein aazmayenge khauf mein se kisi cheez se.","translations":{"en":"And We will surely test you with something of fear.","ur":"اور ہم ضرور تمہیں آزمائیں گے خوف میں سے کسی چیز سے۔","hi":"और हम ज़रूर तुम्हें आज़माएंगे ख़ौफ़ में से किसी चीज़ से।"},"ref":"2:155"},{"id":"s2l5_v16_s6","sentence_number":6,"arabic":"﴿وَمَنْ أَحْسَنُ مِنَ اللهِ صِبْغَةً﴾","arabic_markup":"﴿<span class=\"arabic-root\">وَمَنْ أَحْسَنُ </span><span class=\"nonroot\">مِنَ اللهِ</span> <span class=\"arabic-root\">صِبْغَةً</span>﴾","hinglish":"Aur Allah se behtar kiska rang hai.","translations":{"en":"And who is better than Allah in color?","ur":"اور اللہ سے بہتر کس کا رنگ ہے۔","hi":"और अल्लाह से बेहतर किसका रंग है।"},"ref":"2:138"},{"id":"s2l5_v16_s7","sentence_number":7,"arabic":"﴿وَالْفِتْنَةُ أَشَدُّ مِنَ الْقَتْلِ﴾","arabic_markup":"﴿<span class=\"arabic-root\">وَالْفِتْنَةُ أَشَدُّ </span><span class=\"nonroot\">مِنَ الْقَتْلِ</span>﴾","hinglish":"Aur fitna qatl se zyada sakht hai.","translations":{"en":"And fitnah (discord / persecution) is worse than killing.","ur":"اور فتنہ قتل سے زیادہ سخت ہے۔","hi":"और फ़ितना क़त्ल से ज़्यादा सख्त है।"},"ref":"2:191"},{"id":"s2l5_v16_s8","sentence_number":8,"arabic":"﴿وَمَا هُمْ بِخَارِجِينَ مِنَ النَّارِ﴾","arabic_markup":"﴿<span class=\"arabic-root\">وَمَا هُمْ بِخَارِجِينَ </span><span class=\"nonroot\">مِنَ النَّارِ</span>﴾","hinglish":"Aur woh aag se nikalne wale nahi.","translations":{"en":"And they will not emerge from the Fire.","ur":"اور وہ آگ سے نکلنے والے نہیں۔","hi":"और वह आग से निकलने वाले नहीं।"},"ref":"2:167"},{"id":"s2l5_v16_s9","sentence_number":9,"arabic":"﴿وَمَا أَنزَلَ اللهُ مِنَ السَّمَاءِ﴾","arabic_markup":"﴿<span class=\"arabic-root\">وَمَا أَنزَلَ اللهُ </span><span class=\"nonroot\">مِنَ السَّمَاءِ</span>﴾","hinglish":"Aur jo kuch Allah ne aasmaan se naazil kiya.","translations":{"en":"And what Allah has sent down from the sky.","ur":"اور جو کچھ اللہ نے آسمان سے نازل کیا۔","hi":"और जो कुछ अल्लाह ने आसमान से नाज़िल किया।"},"ref":"2:164"}],"cols":3}},{"id":"sec_s2l5_r17","type":"rule_paragraph","data":{"text":"Q-2: Aane wale Quranic fiqron ka zubani tarjuma karo aur (ال) ke hone ya na hone par dhyan do:"}},{"id":"sec_s2l5_g18","type":"two_col_numbered_list","data":{"is_numbered":false,"items":[{"id":"s2l5_g18_w1","arabic":"مِنَ النَّاسِ","arabic_markup":"<span class=\"nonroot\">مِنَ</span> <span class=\"arabic-root\">النَّاسِ</span>","hinglish":"Logon se","translations":{"en":"From a sign","ur":"کسی نشانی سے","hi":"किसी निशानी से"}},{"id":"s2l5_g18_w2","arabic":"مِنْ كِتَابٍ","arabic_markup":"<span class=\"nonroot\">مِنْ</span> <span class=\"arabic-root\">كِتَاب</span><span class=\"nonroot\">ٍ</span>","hinglish":"Kisi kitaab se","translations":{"en":"From the signs","ur":"نشانیوں میں سے","hi":"निशानियों में से"}},{"id":"s2l5_g18_w3","arabic":"مِنَ الْجِنِّ","arabic_markup":"<span class=\"nonroot\">مِنَ</span> <span class=\"arabic-root\">الْجِنِّ</span>","hinglish":"Jinnon se","translations":{"en":"From the sky","ur":"آسمان سے","hi":"आसमान से"}},{"id":"s2l5_g18_w4","arabic":"مِنَ الْقَوْلِ","arabic_markup":"<span class=\"nonroot\">مِنَ</span> <span class=\"arabic-root\">الْقَوْلِ</span>","hinglish":"Baat se","translations":{"en":"From the heavens","ur":"آسمانوں سے","hi":"आसमानों से"}},{"id":"s2l5_g18_w5","arabic":"مِنْ مَاءٍ","arabic_markup":"<span class=\"nonroot\">مِنْ</span> <span class=\"arabic-root\">مَاء</span><span class=\"nonroot\">ٍ</span>","hinglish":"Kisi paani se","translations":{"en":"From the earth","ur":"زمین سے","hi":"ज़मीन से"}},{"id":"s2l5_g18_w6","arabic":"مِنَ الْعَمَلِ","arabic_markup":"<span class=\"nonroot\">مِنَ</span> <span class=\"arabic-root\">الْعَمَلِ</span>","hinglish":"Amal se","translations":{"en":"From a book","ur":"کسی کتاب سے","hi":"किसी किताब से"}},{"id":"s2l5_g18_w7","arabic":"مِنْ مُشْرِكَةٍ","arabic_markup":"<span class=\"nonroot\">مِنْ</span> <span class=\"arabic-root\">مُشْرِكَة</span><span class=\"nonroot\">ٍ</span>","hinglish":"Kisi mushrik aurat se","translations":{"en":"From the Book","ur":"کتاب میں سے","hi":"किताब में से"}},{"id":"s2l5_g18_w8","arabic":"مِنَ الشَّيْطَانِ","arabic_markup":"<span class=\"nonroot\">مِنَ</span> <span class=\"arabic-root\">الشَّيْطَانِ</span>","hinglish":"Shaitaan se","translations":{"en":"From a punishment","ur":"کسی عذاب سے","hi":"किसी अज़ाब से"}},{"id":"s2l5_g18_w9","arabic":"مِنْ نَارٍ","arabic_markup":"<span class=\"nonroot\">مِنْ</span> <span class=\"arabic-root\">نَار</span><span class=\"nonroot\">ٍ</span>","hinglish":"Kisi aag se","translations":{"en":"From the punishment","ur":"عذاب سے","hi":"अज़ाब से"}},{"id":"s2l5_g18_w10","arabic":"مِنَ الْأَمْنِ","arabic_markup":"<span class=\"nonroot\">مِنَ</span> <span class=\"arabic-root\">الْأَمْنِ</span>","hinglish":"Aman se","translations":{"en":"From the Fire","ur":"آگ سے","hi":"आग से"}},{"id":"s2l5_g18_w11","arabic":"مِنَ الْحَيِّ","arabic_markup":"<span class=\"nonroot\">مِنَ</span> <span class=\"arabic-root\">الْحَيِّ</span>","hinglish":"Zinda se","translations":{"en":"From fire","ur":"کسی آگ سے","hi":"किसी आग से"}},{"id":"s2l5_g18_w12","arabic":"مِنْ عَهْدٍ","arabic_markup":"<span class=\"nonroot\">مِنْ</span> <span class=\"arabic-root\">عَهْد</span><span class=\"nonroot\">ٍ</span>","hinglish":"Kisi waade se","translations":{"en":"From water","ur":"کسی پانی سے","hi":"किसी पानी से"}}],"cols":3}}]}}