":"s1l2_g1_w24","arabic":"الْعِزَّة","arabic_markup":"<span class=\"arabic-root\">الْعِزَّ</span><span class=\"nonroot\">ة</span>","hinglish":"Izzat (Pride)","translations":{"en":"Honor / Might","ur":"عزت / وقار","hi":"इज़्ज़त / सम्मान"}},{"id":"s1l2_g1_w25","arabic":"الْمَغْرِب","arabic_markup":"<span class=\"arabic-root\">الْمَغْرِب</span>","hinglish":"Maghrib/Paschim","translations":{"en":"The West","ur":"مغرب / پچھم","hi":"मग़रिब / पश्चिम"}},{"id":"s1l2_g1_w26","arabic":"الْمَشْرِق","arabic_markup":"<span class=\"arabic-root\">الْمَشْرِق</span>","hinglish":"Mashriq/Poorab","translations":{"en":"The East","ur":"مشرق / پورب","hi":"मशरिक़ / पूरब"}},{"id":"s1l2_g1_w27","arabic":"الْمَغْفِرَة","arabic_markup":"<span class=\"arabic-root\">الْمَغْفِرَ</span><span class=\"nonroot\">ة</span>","hinglish":"Maghfirat/Maafi (Forgiveness)","translations":{"en":"Forgiveness / Pardon","ur":"مغفرت / معافی","hi":"मग़फ़िरत / माफ़ी"}},{"id":"s1l2_g1_w28","arabic":"السَّفَر","arabic_markup":"<span class=\"arabic-root\">السَّفَر</span>","hinglish":"Safar","translations":{"en":"The Journey / Travel","ur":"سفر","hi":"सफ़र / यात्रा"}},{"id":"s1l2_g1_w29","arabic":"الْغُرُوب","arabic_markup":"<span class=\"arabic-root\">الْغُرُوب</span>","hinglish":"Ghoroob/Doobna","translations":{"en":"Setting (of the sun)","ur":"غروب / ڈوبنا","hi":"ग़ुरूब / डूबना"}},{"id":"s1l2_g1_w30","arabic":"الطُّلُوع","arabic_markup":"<span class=\"arabic-root\">الطُّلُوع</span>","hinglish":"Tuloo'/Nikalna","translations":{"en":"Rising (of the sun)","ur":"طلوع / نکلنا","hi":"तुलू / निकलना"}},{"id":"s1l2_g1_w31","arabic":"الْفِرَاق","arabic_markup":"<span class=\"arabic-root\">الْفِرَاق</span>","hinglish":"Firaq/Judai","translations":{"en":"Parting / Separation","ur":"فراق / جدائی","hi":"फ़िराक़ / जुदाई"}},{"id":"s1l2_g1_w32","arabic":"الْعُمْرَة","arabic_markup":"<span class=\"arabic-root\">الْعُمْرَ</span><span class=\"nonroot\">ة</span>","hinglish":"Umrah","translations":{"en":"Umrah (Minor Pilgrimage)","ur":"عمرہ","hi":"उमरा"}},{"id":"s1l2_g1_w33","arabic":"الْآيَة","arabic_markup":"<span class=\"arabic-root\">الْآيَ</span><span class=\"nonroot\">ة</span>","hinglish":"Aayat/Nishani (Sign/Verse)","translations":{"en":"Sign / Verse of the Quran","ur":"آیت / نشانی","hi":"आयत / निशानी"}},{"id":"s1l2_g1_w34","arabic":"الذَّرَّة","arabic_markup":"<span class=\"arabic-root\">الذَّرَّ</span><span class=\"nonroot\">ة</span>","hinglish":"Zarrah/Chhota zarra","translations":{"en":"Atom / Tiny speck","ur":"ذرہ / چھوٹا ذرہ","hi":"ज़र्रा / छोटा कण"}},{"id":"s1l2_g1_w35","arabic":"الشِّفَاء","arabic_markup":"<span class=\"arabic-root\">الشِّفَاء</span>","hinglish":"Shifa (Healing)","translations":{"en":"Healing / Cure","ur":"شفا / علاج","hi":"शिफ़ा / इलाज"}},{"id":"s1l2_g1_w36","arabic":"الْمَرَض","arabic_markup":"<span class=\"arabic-root\">الْمَرَض</span>","hinglish":"Maradh/Bimari","translations":{"en":"Disease / Illness","ur":"مرض / بیماری","hi":"मरज़ / बीमारी"}}],"cols":3}},{"id":"sec_s1l2_r2","type":"rule_paragraph","data":{"text":"Jin alfaaz ke aakhir mein gol 'ta' [ة / ـة] hoti hai, woh muannath (feminine) hote hain. Gaur karein ke iss sabaq aur pichle sabaq mein kaun kaun se alfaaz muannath hain?"}},{"type":"section_label","data":{"text":"Exercise (Page 17 Q-6): Darj zail Qur'ani aayaat mein se un alfaaz ko pehchaniye jinhein aap mukammal samajhte hain:","title":"Exercise (Page 17 Q-6)"}},{"type":"two_col_numbered_list","data":{"cols":3,"is_numbered":true,"items":[{"id":"s1l2_v_s1","arabic":"﴿وَلِلَّهِ الْمَشْرِقُ وَالْمَغْرِبُ﴾","arabic_markup":"﴿<span class=\"nonroot\">وَلِلَّهِ</span> <span class=\"arabic-root\">الْمَشْرِقُ</span> <span class=\"nonroot\">وَ</span><span class=\"arabic-root\">الْمَغْرِبُ</span>﴾","hinglish":"Aur Mashriq aur Maghrib Allah hi ke liye hain","translations":{"en":"And to Allah belong the East and the West","ur":"اور مشرق اور مغرب اللہ ہی کے لیے ہیں","hi":"और पूरब और पश्चिम अल्लाह ही के लिए हैं"},"sentence_number":1,"displayOrder":1,"ref":"2:115"},{"id":"s1l2_v_s2","arabic":"﴿وَضُرِبَتْ عَلَيْهِمُ الذِّلَّةُ﴾","arabic_markup":"﴿<span class=\"nonroot\">وَضُرِبَتْ عَلَيْهِمُ</span> <span class=\"arabic-root\">الذِّلَّةُ</span>﴾","hinglish":"Aur un par zillat musallat kar di gayi","translations":{"en":"And humiliation was stamped upon them","ur":"اور ان پر ذلت مسلط کر دی گئی","hi":"और उन पर ज़िल्लत थोप दी गई"},"sentence_number":2,"displayOrder":2,"ref":"2:61"},{"id":"s1l2_v_s3","arabic":"﴿إِنَّ اللَّهَ يَأْمُرُ بِالْعَدْلِ وَالْإِحْسَانِ﴾","arabic_markup":"﴿<span class=\"nonroot\">إِنَّ</span> <span class=\"arabic-root\">اللَّهَ</span> <span class=\"nonroot\">يَأْمُرُ بِ</span><span class=\"arabic-root\">الْعَدْلِ</span> <span class=\"nonroot\">وَ</span><span class=\"arabic-root\">الْإِحْسَانِ</span>﴾","hinglish":"Beshak Allah insaaf aur ihsaan ka hukm deta hai","translations":{"en":"Indeed, Allah commands justice and good conduct","ur":"بیشک اللہ عدل اور احسان کا حکم دیتا ہے","hi":"बेशक अल्लाह इंसाफ़ और एहसान का हुक्म देता है"},"sentence_number":3,"displayOrder":3,"ref":"16:90"},{"id":"s1l2_v_s4","arabic":"﴿وَيَكُونَ الرَّسُولُ عَلَيْكُمْ شَهِيدًا﴾","arabic_markup":"﴿<span class=\"nonroot\">وَيَكُونَ</span> <span class=\"arabic-root\">الرَّسُولُ</span> <span class=\"nonroot\">عَلَيْكُمْ</span> <span class=\"arabic-root\">شَهِيدًا</span>﴾","hinglish":"Aur Rasool tum par gawah hon","translations":{"en":"And the Messenger may be a witness over you","ur":"اور رسول تم پر گواہ ہوں","hi":"और रसूल तुम पर गवाह हों"},"sentence_number":4,"displayOrder":4,"ref":"2:143"},{"id":"s1l2_v_s5","arabic":"﴿وَجَاهِدْهُمْ بِهِ جِهَادًا كَبِيرًا﴾","arabic_markup":"﴿<span class=\"nonroot\">وَجَاهِدْهُمْ بِهِ</span> <span class=\"arabic-root\">جِهَادًا كَبِيرًا</span>﴾","hinglish":"Aur iske zariye unse bada jihad karo","translations":{"en":"And strive against them with it a great striving","ur":"اور اس کے ذریعے ان سے بڑا جہاد کرو","hi":"और इसके ज़रिए उनसे बड़ा जिहाद करो"},"sentence_number":5,"displayOrder":5,"ref":"25:52"},{"id":"s1l2_v_s6","arabic":"﴿وَسَبِّحْ بِحَمْدِ رَبِّكَ قَبْلَ طُلُوعِ الشَّمْسِ﴾","arabic_markup":"﴿<span class=\"nonroot\">وَسَبِّحْ بِ</span><span class=\"arabic-root\">حَمْدِ رَبِّكَ</span> <span class=\"nonroot\">قَبْلَ</span> <span class=\"arabic-root\">طُلُوعِ الشَّمْسِ</span>﴾","hinglish":"Aur suraj nikalne se pehle apne Rabb ki hamd ke saath tasbeeh karo","translations":{"en":"And glorify the praise of your Lord before the rising of the sun","ur":"اور سورج نکلنے سے پہلے اپنے رب کی حمد کے ساتھ تسبیح کرو","hi":"और सूरज निकलने से पहले अपने रब की हम्द के साथ तसबीह करो"},"sentence_number":6,"displayOrder":6,"ref":"20:130"},{"id":"s1l2_v_s7","arabic":"﴿وَإِنْ كُنْتُمْ عَلَىٰ سَفَرٍ وَلَمْ تَجِدُوا﴾","arabic_markup":"﴿<span class=\"nonroot\">وَإِنْ كُنْتُمْ عَلَىٰ</span> <span class=\"arabic-root\">سَفَرٍ</span> <span class=\"nonroot\">وَلَمْ تَجِدُوا</span>﴾","hinglish":"Aur agar tum safar par ho aur na paao","translations":{"en":"And if you are on a journey and cannot find","ur":"اور اگر تم سفر پر ہو اور نہ پاؤ","hi":"और अगर तुम सफ़र पर हो और न पाओ"},"sentence_number":7,"displayOrder":7,"ref":"2:283"},{"id":"s1l2_v_s8","arabic":"﴿أَنَّ اللَّهَ يَبْسُطُ الرِّزْقَ لِمَنْ يَشَاءُ﴾","arabic_markup":"﴿<span class=\"nonroot\">أَنَّ</span> <span class=\"arabic-root\">اللَّهَ</span> <span class=\"nonroot\">يَبْسُطُ</span> <span class=\"arabic-root\">الرِّزْقَ</span> <span class=\"nonroot\">لِمَنْ يَشَاءُ</span>﴾","hinglish":"Beshak Allah jiske liye chahta hai rizq kushada kar deta hai","translations":{"en":"Indeed, Allah extends provision for whom He wills","ur":"بیشک اللہ جس کے لیے چاہتا ہے رزق فراخ کر دیتا ہے","hi":"बेशक अल्लाह जिसके लिए चाहता है रिज़्क़ कुशादा कर देता है"},"sentence_number":8,"displayOrder":8,"ref":"30:37"},{"id":"s1l2_v_s9","arabic":"﴿وَالْعَمَلُ الصَّالِحُ يَرْفَعُهُ﴾","arabic_markup":"﴿<span class=\"nonroot\">وَ</span><span class=\"arabic-root\">الْعَمَلُ الصَّالِحُ</span> <span class=\"nonroot\">يَرْفَعُهُ</span>﴾","hinglish":"Aur nek amal use buland karta hai","translations":{"en":"And the righteous deed raises it","ur":"اور نیک عمل اسے بلند کرتا ہے","hi":"और नेक अमल उसे बुलंद करता है"},"sentence_number":9,"displayOrder":9,"ref":"35:10"}]}}]}}