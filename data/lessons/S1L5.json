    {
      "id": "sec_s1l5_lbl0",
      "type": "section_label",
      "data": {
        "text": "Darj zail Qur'ani alfaaz ke ma'ani aam taur par aap jaante honge. Nisbatan naye alfaaz ke ma'ani unke saath de diye gaye hain. Faraham karda jagahon mein inke matlab likhein:",
        "title": "Darj zail Qur'ani alfaaz ke ma'ani aam taur par aap jaante honge. Nisbatan naye alfaaz ke ma'ani unke saath de diye gaye hain. Faraham karda jagahon mein inke matlab likhein:",
        "label": "Darj zail Qur'ani alfaaz ke ma'ani aam taur par aap jaante honge. Nisbatan naye alfaaz ke ma'ani unke saath de diye gaye hain. Faraham karda jagahon mein inke matlab likhein:"
      }
