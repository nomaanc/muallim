span class=\"arabic-root\">الْحِسَاب</span>","hinglish":"Hisaab","translations":{"en":"Account / Reckoning","ur":"حساب","hi":"हिसाब / लेखा-जोखा"}},{"id":"s1l6_g1_w25","arabic":"الْمُجْرِم","arabic_markup":"<span class=\"arabic-root\">الْمُجْرِم</span>","hinglish":"Mujrim / Gunaahgar","translations":{"en":"Criminal / Sinner","ur":"مجرم / گناہگار","hi":"मुजरिम / गुनहगार"}},{"id":"s1l6_g1_w26","arabic":"الشَّكّ","arabic_markup":"<span class=\"arabic-root\">الشَّكّ</span>","hinglish":"Shak / Gumaan","translations":{"en":"Doubt","ur":"شک / گمان","hi":"शक / संदेह"}},{"id":"s1l6_g1_w27","arabic":"الْيَقِين","arabic_markup":"<span class=\"arabic-root\">الْيَقِين</span>","hinglish":"Yaqeen","translations":{"en":"Certainty","ur":"یقین","hi":"यक़ीन / निश्चय"}},{"id":"s1l6_g1_w28","arabic":"التَّسْبِيح","arabic_markup":"<span class=\"arabic-root\">التَّسْبِيح</span>","hinglish":"Tasbeeh / Tareef","translations":{"en":"Glorification","ur":"تسبیح / پاکی بیان کرنا","hi":"तसबीह / गुणगान"}},{"id":"s1l6_g1_w29","arabic":"الْقَرْيَة","arabic_markup":"<span class=\"arabic-root\">الْقَرْيَة</span>","hinglish":"Basti / Gaon","translations":{"en":"Town / Village","ur":"بستی / گاؤں","hi":"बस्ती / गाँव"}},{"id":"s1l6_g1_w30","arabic":"الْفَرِيضَة","arabic_markup":"<span class=\"arabic-root\">الْفَرِيضَة</span>","hinglish":"Farz / Farz kaam","translations":{"en":"Obligation / Ordained Duty","ur":"فریضہ / فرض","hi":"फ़रीज़ा / फ़र्ज़"}},{"id":"s1l6_g1_w31","arabic":"الْحِجَاب","arabic_markup":"<span class=\"arabic-root\">الْحِجَاب</span>","hinglish":"Hijab / Parda","translations":{"en":"Veil / Screen","ur":"حجاب / پردہ","hi":"हिजाब / पर्दा"}},{"id":"s1l6_g1_w32","arabic":"السُّرُور","arabic_markup":"<span class=\"arabic-root\">السُّرُور</span>","hinglish":"Khushi / Suroor","translations":{"en":"Happiness / Joy","ur":"خوشی / سرور","hi":"ख़ुशी / सुरूर"}},{"id":"s1l6_g1_w33","arabic":"الْجَلَال","arabic_markup":"<span class=\"arabic-root\">الْجَلَال</span>","hinglish":"Jalaal / Azmat","translations":{"en":"Majesty / Glory","ur":"جلال / عظمت","hi":"जलाल / महिमा"}},{"id":"s1l6_g1_w34","arabic":"الشَّهَادَة","arabic_markup":"<span class=\"arabic-root\">الشَّهَادَة</span>","hinglish":"Shahaadat / Gawahi","translations":{"en":"Testimony / Witness","ur":"شہادت / گواہی","hi":"शहादत / गवाही"}},{"id":"s1l6_g1_w35","arabic":"الْمَعْذِرَة","arabic_markup":"<span class=\"arabic-root\">الْمَعْذِرَة</span>","hinglish":"Uzr / Maafi","translations":{"en":"Excuse / Apology","ur":"عذر / معافی","hi":"उज़्र / माफ़ी"}},{"id":"s1l6_g1_w36","arabic":"الْمُسْتَقِيم","arabic_markup":"<span class=\"arabic-root\">الْمُسْتَقِيم</span>","hinglish":"Seedha / Sahi rasta","translations":{"en":"Straight / Upright","ur":"سیدھا / مستقیم","hi":"सीधा / सीधा मार्ग"}}],"cols":3}},{"id":"sec_s1l6_r2","type":"rule_paragraph","data":{"text":"Agar kisi lafz ke shuru mein [ اَلْـ ] aaye, toh aam taur par uske aakhiri harf par Pesh (Dammah) [ ُ ] aata hai, jaise [ اَلرَّحْمٰنُ ]. Lekin jumle ke hisaab se aakhir mein Zabar (Fatha) [ َ ] ya Zer (Kasrah) [ ِ ] bhi aa sakti hai. iss se lafz ke maani par koi farq nahi padta."}},{"id":"sec_s1l6_r3","type":"rule_paragraph","data":{"text":"Ab aap darj zail Qur'ani fiqron aur aayaton ko khud samajh aur tarjuma kar sakte hain."}},{"id":"sec_s1l6_lbl4","type":"section_label","data":{"text":"**Exercise (Practice):** Darj zail Qur'ani aayaton mein se un alfaaz ko highlight karein jinhe aap mukammal taur par samajhte hain:"}},{"id":"sec_s1l6_v5","type":"two_col_numbered_list","data":{"is_numbered":true,"items":[{"id":"s1l6_v5_s1","sentence_number":1,"arabic":"الْمَالُ وَالْبَنُونَ زِينَةُ الْحَيَاةِ الدُّنْيَا","arabic_markup":"<span class=\"nonroot\">الْ</span><span class=\"arabic-root\">مَالُ</span> <span class=\"arabic-root\">وَالْبَن</span><span class=\"nonroot\">ُونَ</span> <span class=\"arabic-root\">زِينَةُ</span> <span class=\"nonroot\">الْ</span><span class=\"arabic-root\">حَيَاةِ</span> <span class=\"arabic-root\">الدُّنْيَا</span>","hinglish":"Maal aur beta dunya ki zindagi ki zeenat hain","translations":{"ur":"مال اور بیٹے دنیا کی زندگی کی زینت ہیں","en":"Wealth and children are the adornment of the worldly life","hi":"माल और बेटे दुनिया की ज़िंदगी की ज़ीनत हैं"},"ref":"18:46"},{"id":"s1l6_v5_s2","sentence_number":2,"arabic":"وَزَادَهُ بَسْطَةً فِي الْعِلْمِ وَالْجِسْمِ","arabic_markup":"<span class=\"arabic-root\">وَزَادَهُ</span> <span class=\"arabic-root\">بَسْطَةً</span> <span class=\"nonroot\">فِي</span> <span class=\"nonroot\">الْ</span><span class=\"arabic-root\">عِلْمِ</span> <span class=\"nonroot\">وَالْ</span><span class=\"arabic-root\">جِسْمِ</span>","hinglish":"Aur use ilm aur jism mein kushadgi di","translations":{"ur":"اور اسے علم اور جسم میں کشادگی دی","en":"And increased him abundantly in knowledge and stature","hi":"और उसे इल्म और जिस्म में कुशादगी दी"},"ref":"2:247"},{"id":"s1l6_v5_s3","sentence_number":3,"arabic":"أَدْعُوكُمْ إِلَى النَّجَاةِ","arabic_markup":"<span class=\"arabic-root\">أَدْعُو</span><span class=\"nonroot\">كُمْ</span> <span class=\"nonroot\">إِلَى</span> <span class=\"arabic-root\">النَّجَاةِ</span>","hinglish":"Main tumhein najaat ki taraf bulata hoon","translations":{"ur":"میں تمہیں نجات کی طرف بلاتا ہوں","en":"I invite you to salvation","hi":"मैं तुम्हें नजात की तरफ़ बुलाता हूँ"},"ref":"40:41"},{"id":"s1l6_v5_s4","sentence_number":4,"arabic":"فَإِنَّمَا عَلَيْكَ الْبَلَاغُ وَعَلَيْنَا الْحِسَابُ","arabic_markup":"<span class=\"arabic-root\">فَإِنَّمَا</span> <span class=\"nonroot\">عَلَيْكَ</span> <span class=\"nonroot\">الْ</span><span class=\"arabic-root\">بَلَاغُ</span> <span class=\"arabic-root\">وَعَلَي</span><span class=\"nonroot\">ْنَا</span> <span class=\"nonroot\">الْ</span><span class=\"arabic-root\">حِسَابُ</span>","hinglish":"Bas aap par paigham pahunchana hai aur humare zimme hisaab hai","translations":{"ur":"بس آپ پر پیغام پہنچانا ہے اور ہمارے ذمے حساب ہے","en":"Upon you is only the notification, and upon Us is the account","hi":"बस आप पर पैग़ाम पहुँचाना है और हमारे ज़िम्मे हिसाब है"},"ref":"13:40"},{"id":"s1l6_v5_s5","sentence_number":5,"arabic":"فَرِيضَةً مِنَ اللَّهِ","arabic_markup":"<span class=\"arabic-root\">فَرِيضَةً</span> <span class=\"nonroot\">مِنَ</span> <span class=\"arabic-root\">اللَّهِ</span>","hinglish":"Allah ki taraf se ek farz","translations":{"ur":"اللہ کی طرف سے ایک فرض","en":"An obligation imposed by Allah","hi":"अल्लाह की तरफ़ से एक फ़र्ज़"}},{"id":"s1l6_v5_s6","sentence_number":6,"arabic":"وَيَأْمُرُونَ النَّاسَ بِالْبُخْلِ","arabic_markup":"<span class=\"arabic-root\">وَيَأْمُر</span><span class=\"nonroot\">ُونَ</span> <span class=\"arabic-root\">النَّاسَ</span> <span class=\"nonroot\">بِالْ</span><span class=\"arabic-root\">بُخْلِ</span>","hinglish":"Aur woh logon ko kanjoosi ka hukm dete hain","translations":{"ur":"اور وہ لوگوں کو کنجوسی کا حکم دیتے ہیں","en":"And enjoin upon the people stinginess","hi":"और वे लोगों को कंजूसी का हुक्म देते हैं"}},{"id":"s1l6_v5_s7","sentence_number":7,"arabic":"وَيَقُولُونَ مَتَى هَذَا الْفَتْحُ","arabic_markup":"<span class=\"arabic-root\">وَيَقُول</span><span class=\"nonroot\">ُونَ</span> <span class=\"arabic-root\">مَتَى</span> <span class=\"nonroot\">هَذَا</span> <span class=\"nonroot\">الْ</span><span class=\"arabic-root\">فَتْحُ</span>","hinglish":"Aur woh kehte hain yeh fath kab hogi","translations":{"ur":"اور وہ کہتے ہیں یہ فتح کب ہوگی؟","en":"And they say, 'When is this conquest?'","hi":"और वे कहते हैं यह फ़तह कब होगी?"},"ref":"32:28"},{"id":"s1l6_v5_s8","sentence_number":8,"arabic":"إِنْ أُرِيدُ إِلَّا الْإِصْلَاحَ","arabic_markup":"<span class=\"nonroot\">إِنْ</span> <span class=\"arabic-root\">أُرِيدُ</span> <span class=\"nonroot\">إِلَّا</span> <span class=\"nonroot\">الْ</span><span class=\"arabic-root\">إِصْلَاحَ</span>","hinglish":"Main toh sirf sudhaar chahta hoon","translations":{"ur":"میں تو صرف اصلاح چاہتا ہوں","en":"I only intend reform","hi":"मैं तो सिर्फ़ सुधार चाहता हूँ"},"ref":"11:88"},{"id":"s1l6_v5_s9","sentence_number":9,"arabic":"شَهْرُ رَمَضَانَ الَّذِي أُنْزِلَ فِيهِ الْقُرْآنُ","arabic_markup":"<span class=\"arabic-root\">شَهْرُ</span> <span class=\"arabic-root\">رَمَضَانَ</span> <span class=\"nonroot\">الَّذِي</span> <span class=\"arabic-root\">أُنْزِلَ</span> <span class=\"nonroot\">فِيهِ</span> <span class=\"nonroot\">الْ</span><span class=\"arabic-root\">قُرْآنُ</span>","hinglish":"Ramazan ka mahina woh hai jismein Qur'an utara gaya","translations":{"ur":"رمضان کا مہینہ وہ ہے جس میں قرآن اتارا گیا","en":"The month of Ramadan in which the Qur'an was revealed","hi":"रमज़ान का महीना वह है जिसमें क़ुरआन उतारा गया"},"ref":"2:185"},{"id":"s1l6_v5_s10","sentence_number":10,"arabic":"وَنُذِيقُهُ يَوْمَ الْقِيَامَةِ عَذَابَ الْحَرِيقِ","arabic_markup":"<span class=\"arabic-root\">وَنُذِيقُهُ</span> <span class=\"arabic-root\">يَوْمَ</span> <span class=\"nonroot\">الْ</span><span class=\"arabic-root\">قِيَامَةِ</span> <span class=\"arabic-root\">عَذَابَ</span> <span class=\"nonroot\">الْ</span><span class=\"arabic-root\">حَرِيقِ</span>","hinglish":"Aur hum use qiyamat ke din jalne wala azaab chakhayeinge","translations":{"ur":"اور ہم اسے قیامت کے دن جلنے والا عذاب چکھائیں گے","en":"And We will make him taste on the Day of Resurrection the punishment of the Burning Fire","hi":"और हम उसे क़ियामत के दिन जलने वाला अज़ाब चखाएँगे"},"ref":"22:9"},{"id":"s1l6_v5_s11","sentence_number":11,"arabic":"مَوْعِدُكُمْ يَوْمُ الزِّينَةِ","arabic_markup":"<span class=\"arabic-root\">مَوْعِدُ</span><span class=\"nonroot\">كُمْ</span> يَوْمُ الزِّينَةِ","hinglish":"Tumhara waada zeenat ke din hai","translations":{"en":"Your appointment is the day of festival","ur":"تمہارا وعدہ جشن (زینت) کا دن ہے","hi":"तुम्हारे वादे का समय उत्सव (ज़ीनत) का दिन है"},"ref":"20:59"},{"id":"s1l6_v5_s12","sentence_number":12,"arabic":"لَهُمْ مَغْفِرَةٌ وَأَجْرٌ كَبِيرٌ","arabic_markup":"<span class=\"nonroot\">لَهُمْ</span> <span class=\"arabic-root\">مَغْفِرَةٌ</span> <span class=\"arabic-root\">وَأَجْرٌ</span> <span class=\"arabic-root\">كَبِيرٌ</span>","hinglish":"Unke liye maghfirat aur bada ajr hai","translations":{"ur":"ان کے لیے مغفرت اور بڑا اجر ہے","en":"For them is forgiveness and a great reward","hi":"उनके लिए मग़फ़िरत और बड़ा अज्र है"},"ref":"11:11"}],"cols":3}}]}}