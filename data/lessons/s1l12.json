ْمُنْكَرِ وَالْبَغْيِ","arabic_markup":"<span class=\"arabic-root\">الْفَحْشَاءِ </span><span class=\"nonroot\">وَ</span><span class=\"arabic-root\">الْمُنْكَرِ </span><span class=\"nonroot\">وَ</span><span class=\"arabic-root\">الْبَغْيِ</span>","hinglish":"Behayaai, Buraai aur Ziyadati","translations":{"en":"Immorality, bad deeds, and oppression","ur":"بے حیائی، برائی اور زیادتی (سرکشی)","hi":"बेहयाई, बुराई और ज़्यादती"},"ref":"16:90"},{"id":"s1l12_g8_w8","arabic":"وَالشَّمْسَ وَالْقَمَرَ وَالنُّجُومَ","arabic_markup":"<span class=\"nonroot\">وَ</span><span class=\"arabic-root\">الشَّمْسَ </span><span class=\"nonroot\">وَ</span><span class=\"arabic-root\">الْقَمَرَ </span><span class=\"nonroot\">وَ</span><span class=\"arabic-root\">النُّجُومَ</span>","hinglish":"Aur Suraj, Chaand aur Sitare","translations":{"en":"And the sun, the moon, and the stars","ur":"اور سورج، چاند اور ستارے","hi":"और सूरज, चाँद और सितारे"}},{"id":"s1l12_g8_w9","arabic":"السَّمْعَ وَالْبَصَرَ وَالْفُؤَادَ","arabic_markup":"<span class=\"arabic-root\">السَّمْعَ </span><span class=\"nonroot\">وَ</span><span class=\"arabic-root\">الْبَصَرَ </span><span class=\"nonroot\">وَ</span><span class=\"arabic-root\">الْفُؤَادَ</span>","hinglish":"Kaan, Aankh aur Dil","translations":{"en":"Hearing, sight, and the heart","ur":"کان، آنکھ اور دل","hi":"कान, आँख और दिल"},"ref":"17:36"}],"cols":3}},{"id":"sec_s1l12_r9","type":"rule_paragraph","data":{"text":"Kabhi kabhi (وَ) char ya paanch alfaaz ko bhi aapas mein jodta hai. Neeche diye gaye Qur'ani fiqron ko padhiye aur unka tarjuma kijiye. Aap bina kisi madad ke unhe samajh sakte hain."}},{"id":"sec_s1l12_g10","type":"two_col_numbered_list","data":{"is_numbered":false,"items":[{"id":"s1l12_g10_w1","arabic":"اللَّيْلُ وَالنَّهَارُ وَالشَّمْسُ وَالْقَمَرُ","arabic_markup":"<span class=\"arabic-root\">اللَّيْلُ </span><span class=\"nonroot\">وَ</span><span class=\"arabic-root\">النَّهَارُ </span><span class=\"nonroot\">وَ</span><span class=\"arabic-root\">الشَّمْسُ </span><span class=\"nonroot\">وَ</span><span class=\"arabic-root\">الْقَمَرُ</span>","hinglish":"Raat, Din, Suraj aur Chaand","translations":{"en":"The night, the day, the sun, and the moon","ur":"رات، دن، سورج اور چاند","hi":"रात, दिन, सूरज और चाँद"}},{"id":"s1l12_g10_w2","arabic":"الْكِتَابَ وَالْحِكْمَةَ وَالتَّوْرَاةَ وَالْإِنْجِيلَ","arabic_markup":"<span class=\"arabic-root\">الْكِتَابَ </span><span class=\"nonroot\">وَ</span><span class=\"arabic-root\">الْحِكْمَةَ </span><span class=\"nonroot\">وَ</span><span class=\"arabic-root\">التَّوْرَاةَ </span><span class=\"nonroot\">وَ</span><span class=\"arabic-root\">الْإِنْجِيلَ</span>","hinglish":"Kitaab, Hikmat, Tawraat aur Injeel","translations":{"en":"The Book, wisdom, the Torah, and the Gospel","ur":"کتاب، حکمت، تورات اور انجیل","hi":"किताब, हिकमत, तौरात और इंजील"}},{"id":"s1l12_g10_w3","arabic":"نُوحٍ وَإِبْرَاهِيمَ وَمُوسَىٰ وَعِيسَىٰ","arabic_markup":"<span class=\"arabic-root\">نُوحٍ </span><span class=\"nonroot\">وَ</span><span class=\"arabic-root\">إِبْرَاهِيمَ </span><span class=\"nonroot\">وَ</span><span class=\"arabic-root\">مُوسَىٰ </span><span class=\"nonroot\">وَ</span><span class=\"arabic-root\">عِيسَىٰ</span>","hinglish":"Nuh, Ibrahim, Musa aur Eesa (Alaihis Salam)","translations":{"en":"Noah, Abraham, Moses, and Jesus (peace be upon them)","ur":"نوح، ابراہیم، موسیٰ اور عیسیٰ (علیہم السلام)","hi":"नूह, इब्राहीम, मूसा और ईसा (अलैहिमुस्सलाम)"},"ref":"33:7"},{"id":"s1l12_g10_w4","arabic":"وَزَكَرِيَّا وَيَحْيَىٰ وَعِيسَىٰ وَإِلْيَاسَ","arabic_markup":"<span class=\"nonroot\">وَ</span><span class=\"arabic-root\">زَكَرِيَّا </span><span class=\"nonroot\">وَ</span><span class=\"arabic-root\">يَحْيَىٰ </span><span class=\"nonroot\">وَ</span><span class=\"arabic-root\">عِيسَىٰ </span><span class=\"nonroot\">وَ</span><span class=\"arabic-root\">إِلْيَاسَ</span>","hinglish":"Aur Zakariyya, Yahya, Eesa aur Ilyas (Alaihis Salam)","translations":{"en":"Abraham, Ishmael, Isaac, and Jacob (peace be upon them)","ur":"ابراہیم، اسماعیل، اسحاق اور یعقوب (علیہم السلام)","hi":"इब्राहीम, इस्माईल, इस्हाक़ और याक़ूब (अलैहिमुस्सलाम)"},"ref":"6:85"},{"id":"s1l12_g10_w5","arabic":"وَإِسْمَاعِيلَ وَالْيَسَعَ وَيُونُسَ وَلُوطًا","arabic_markup":"<span class=\"nonroot\">وَ</span><span class=\"arabic-root\">إِسْمَاعِيلَ </span><span class=\"nonroot\">وَ</span><span class=\"arabic-root\">الْيَسَعَ </span><span class=\"nonroot\">وَ</span><span class=\"arabic-root\">يُونُسَ </span><span class=\"nonroot\">وَ</span><span class=\"arabic-root\">لُوطًا</span>","hinglish":"Aur Ismail, Al-Yasa', Yunus aur Loot (Alaihis Salam)","translations":{"en":"The believers, the Jews, the Sabians, and the Christians","ur":"مومن، یہودی، صابئین اور نصاریٰ","hi":"मोमिन, यहूदी, साबिईन और नसारा"},"ref":"6:86"},{"id":"s1l12_g10_w6","arabic":"دَاوُودَ وَسُلَيْمَانَ وَأَيُّوبَ وَيُوسُفَ وَمُوسَىٰ وَهَارُونَ","arabic_markup":"<span class=\"arabic-root\">دَاوُودَ </span><span class=\"nonroot\">وَ</span><span class=\"arabic-root\">سُلَيْمَانَ </span><span class=\"nonroot\">وَ</span><span class=\"arabic-root\">أَيُّوبَ </span><span class=\"nonroot\">وَ</span><span class=\"arabic-root\">يُوسُفَ </span><span class=\"nonroot\">وَ</span><span class=\"arabic-root\">مُوسَىٰ </span><span class=\"nonroot\">وَ</span><span class=\"arabic-root\">هَارُونَ</span>","hinglish":"Dawood, Sulaiman, Ayyub, Yusuf, Musa aur Haroon (Alaihis Salam)","translations":{"en":"Abraham, Ishmael, Isaac, Jacob, and the descendants (tribes)","ur":"ابراہیم، اسماعیل، اسحاق، یعقوب اور اولادِ یعقوب (اسباط)","hi":"इब्राहीम, इस्माईल, इस्हाक़, याक़ूब और औलाद-ए-याक़ूब (अस्बात)"},"ref":"6:84"}],"cols":3}}]}}