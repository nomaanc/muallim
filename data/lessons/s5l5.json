\"#f0f9ff\" stroke=\"#0284c7\" stroke-width=\"2\"/>\n          <text x=\"120\" y=\"30\" text-anchor=\"middle\" font-family=\"'Amiri','Scheherazade New',serif\" font-size=\"20\" font-weight=\"bold\" fill=\"#1e293b\" direction=\"rtl\">مُجَاهِدُونَ</text>\n          <text x=\"120\" y=\"52\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"14\" font-weight=\"bold\" fill=\"#0284c7\">↓</text>\n          <text x=\"120\" y=\"76\" text-anchor=\"middle\" font-family=\"'Amiri','Scheherazade New',serif\" font-size=\"22\" font-weight=\"bold\" fill=\"#0284c7\" direction=\"rtl\">هُمْ مُجَاهِدُونَ</text>\n          <text x=\"120\" y=\"96\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"12\" font-weight=\"bold\" fill=\"#0f172a\">mujaahid → woh log mujaahid hain</text>\n          <text x=\"120\" y=\"111\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"10.5\" fill=\"#475569\">3+ mardon ke liye (هُمْ)</text>\n        </g>\n        <g transform=\"translate(540, 74)\">\n          <rect width=\"240\" height=\"118\" rx=\"14\" fill=\"#f5f3ff\" stroke=\"#7c3aed\" stroke-width=\"2\"/>\n          <text x=\"120\" y=\"30\" text-anchor=\"middle\" font-family=\"'Amiri','Scheherazade New',serif\" font-size=\"20\" font-weight=\"bold\" fill=\"#1e293b\" direction=\"rtl\">الْمُتَّقُونَ</text>\n          <text x=\"120\" y=\"52\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"14\" font-weight=\"bold\" fill=\"#7c3aed\">↓</text>\n          <text x=\"120\" y=\"76\" text-anchor=\"middle\" font-family=\"'Amiri','Scheherazade New',serif\" font-size=\"22\" font-weight=\"bold\" fill=\"#7c3aed\" direction=\"rtl\">هُمُ الْمُتَّقُونَ</text>\n          <text x=\"120\" y=\"96\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"12\" font-weight=\"bold\" fill=\"#0f172a\">parhezgaar → wahi log parhezgaar hain</text>\n          <text x=\"120\" y=\"111\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"10.5\" fill=\"#475569\">Hum + Al- = Hasr (wahi log hi)</text>\n        </g>\n  <rect x=\"30\" y=\"202\" width=\"740\" height=\"24\" rx=\"8\" fill=\"#f8fafc\" stroke=\"#cbd5e1\" stroke-width=\"1\"/>\n  <text x=\"400\" y=\"218\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"11.5\" font-weight=\"600\" fill=\"#334155\">Qaa'ida: (هُوَ) ek shakhs ke liye aur (هُمْ: woh log) teen ya zaa'id logon ke baare mein baat karne ke liye aata hai.</text>\n</svg>\n</div>In misaalon se waazeh hai ke (هُمْ) ka matlab (woh log) hai aur yeh bahut se mardon ka zikr karne ke liye istemaal hota hai. (هُوَ) ek shakhs ke baare mein aur (هُمْ) zyaada logon (teen ya zaa'id) ke baare mein baat karne ke liye aata hai. (هُمْ) aur uske baad jama ka lafz mil kar umooman ek mukammal jumla banaate hain:"}},{"type":"section_label","text":"1. Jama ka Lafz ← هُمْ ke saath Qur'ani Jumle (13 Pairs)","data":{"text":"1. Jama ka Lafz ← هُمْ ke saath Qur'ani Jumle (13 Pairs)"}},{"type":"two_col_numbered_list","is_numbered":false,"data":{"items":[{"id":"s5l5_pairs_1","arabic":"خَالِدُونَ ← هُمْ خَالِدُونَ","hinglish":"woh hamesha rehne wale hain","translations":{"en":"They will abide eternally","ur":"وہ ہمیشہ رہنے والے ہیں","hi":"वह हमेशा रहने वाले हैं"},"arabic_markup":"<span class=\"arabic-root\">خَالِدُونَ ← </span><span class=\"nonroot\">هُمْ</span> <span class=\"arabic-root\">خَالِدُونَ</span>","displayOrder":0},{"id":"s5l5_pairs_2","arabic":"مُظْلِمُونَ ← هُمْ مُظْلِمُونَ","hinglish":"woh andhere mein hain","translations":{"en":"They are in darkness","ur":"وہ اندھیرے میں ہیں","hi":"वह अँधेरे में हैं"},"arabic_markup":"<span class=\"arabic-root\">مُظْلِمُونَ ← </span><span class=\"nonroot\">هُمْ</span> <span class=\"arabic-root\">مُظْلِمُونَ</span>","displayOrder":2},{"id":"s5l5_pairs_3","arabic":"مُحْسِنُونَ ← هُمْ مُحْسِنُونَ","hinglish":"woh ehsan karne wale hain","translations":{"en":"They are doers of good","ur":"وہ احسان کرنے والے ہیں","hi":"वह एहसान करने वाले हैं"},"arabic_markup":"<span class=\"arabic-root\">مُحْسِنُونَ ← </span><span class=\"nonroot\">هُمْ</span> <span class=\"arabic-root\">مُحْسِنُونَ</span>","displayOrder":4},{"id":"s5l5_pairs_4","arabic":"دَائِمُونَ ← هُمْ دَائِمُونَ","hinglish":"woh paband hain","translations":{"en":"They are constant","ur":"وہ پابند ہیں","hi":"वह पाबंद हैं"},"arabic_markup":"<span class=\"arabic-root\">دَائِمُونَ ← </span><span class=\"nonroot\">هُمْ</span> <span class=\"arabic-root\">دَائِمُونَ</span>","displayOrder":6},{"id":"s5l5_pairs_5","arabic":"مُشْفِقُونَ ← هُمْ مُشْفِقُونَ","hinglish":"woh dare hue hain","translations":{"en":"They are fearful","ur":"وہ ڈرے ہوئے ہیں","hi":"वह डरे हुए हैं"},"arabic_markup":"<span class=\"arabic-root\">مُشْفِقُونَ ← </span><span class=\"nonroot\">هُمْ</span> <span class=\"arabic-root\">مُشْفِقُونَ</span>","displayOrder":8},{"id":"s5l5_pairs_6","arabic":"مُعْرِضُونَ ← هُمْ مُعْرِضُونَ","hinglish":"woh aeraaz karne wale hain","translations":{"en":"They are turning away","ur":"وہ اعراض کرنے والے ہیں","hi":"वह मुँह मोड़ने वाले हैं"},"arabic_markup":"<span class=\"arabic-root\">مُعْرِضُونَ ← </span><span class=\"nonroot\">هُمْ</span> <span class=\"arabic-root\">مُعْرِضُونَ</span>","displayOrder":10},{"id":"s5l5_pairs_7","arabic":"كَافِرُونَ ← هُمْ كَافِرُونَ","hinglish":"woh inkar karne wale hain","translations":{"en":"They are disbelievers","ur":"وہ انکار کرنے والے ہیں","hi":"वह इनकार करने वाले हैं"},"arabic_markup":"<span class=\"arabic-root\">كَافِرُونَ ← </span><span class=\"nonroot\">هُمْ</span> <span class=\"arabic-root\">كَافِرُونَ</span>","displayOrder":1},{"id":"s5l5_pairs_8","arabic":"مُشْرِكُونَ ← هُمْ مُشْرِكُونَ","hinglish":"woh shirk karne wale hain","translations":{"en":"They are polytheists","ur":"وہ شرک کرنے والے ہیں","hi":"वह शिर्क करने वाले हैं"},"arabic_markup":"<span class=\"arabic-root\">مُشْرِكُونَ ← </span><span class=\"nonroot\">هُمْ</span> <span class=\"arabic-root\">مُشْرِكُونَ</span>","displayOrder":3},{"id":"s5l5_pairs_9","arabic":"غَافِلُونَ ← هُمْ غَافِلُونَ","hinglish":"woh be-khabar hain","translations":{"en":"They are heedless","ur":"وہ بے خبر ہیں","hi":"वह बेख़बर हैं"},"arabic_markup":"<span class=\"arabic-root\">غَافِلُونَ ← </span><span class=\"nonroot\">هُمْ</span> <span class=\"arabic-root\">غَافِلُونَ</span>","displayOrder":5},{"id":"s5l5_pairs_10","arabic":"خَامِدُونَ ← هُمْ خَامِدُونَ","hinglish":"woh be-jaan hain","translations":{"en":"They are lifeless","ur":"وہ بے جان ہیں","hi":"वह बेजान हैं"},"arabic_markup":"<span class=\"arabic-root\">خَامِدُونَ ← </span><span class=\"nonroot\">هُمْ</span> <span class=\"arabic-root\">خَامِدُونَ</span>","displayOrder":7},{"id":"s5l5_pairs_11","arabic":"مُبْلِسُونَ ← هُمْ مُبْلِسُونَ","hinglish":"woh mayoos hain","translations":{"en":"They are in despair","ur":"وہ مایوس ہیں","hi":"वह मायूस हैं"},"arabic_markup":"<span class=\"arabic-root\">مُبْلِسُونَ ← </span><span class=\"nonroot\">هُمْ</span> <span class=\"arabic-root\">مُبْلِسُونَ</span>","displayOrder":9},{"id":"s5l5_pairs_12","arabic":"أَصْحَابُ النَّارِ ← هُمْ أَصْحَابُ النَّارِ","hinglish":"woh aag wale hain","translations":{"en":"They are companions of the Fire","ur":"وہ آگ والے ہیں","hi":"वह आग वाले हैं"},"arabic_markup":"<span class=\"arabic-root\">أَصْحَابُ النَّارِ ← </span><span class=\"nonroot\">هُمْ</span> <span class=\"arabic-root\">أَصْحَابُ النَّارِ</span>","displayOrder":11},{"id":"s5l5_pairs_13","arabic":"وَوَيْلٌ لِلْكَافِرِينَ مِنْ عَذَابٍ شَدِيدٍ / وَيَوْمَ الْقِيَامَةِ هُمْ مِنَ الْمَقْبُوحِينَ","hinglish":"Aur halakat hai kaafiron ke liye sakht azab se aur qayamat ke din woh badnuma banaye gaye logon mein se honge","translations":{"en":"And woe to the disbelievers from a severe punishment / and on the Day of Resurrection they will be of the despised","ur":"اور ہلاکت ہے کافروں کے لیے سخت عذاب سے اور قیامت کے دن وہ بدحال کیے گئے لوگوں میں سے ہوں گے","hi":"और हलाकत है काफ़िरों के लिए सख़्त अज़ाब से और क़यामत के दिन वह बदहाल किए गए लोगों में से होंगे"},"arabic_markup":"<span class=\"arabic-root\">وَوَيْلٌ لِلْكَافِرِينَ مِنْ عَذَابٍ شَدِيدٍ / وَيَوْمَ الْقِيَامَةِ </span><span class=\"nonroot\">هُمْ</span><span class=\"arabic-root\"> مِنَ الْمَقْبُوحِينَ</span>","displayOrder":12}],"is_numbered":false}},{"type":"rule_paragraph","text":"Ba'z auqaat (هُمْ) aur jama waale lafz ke darmiyaan koi aur lafz hota hai, ya (هُمْ) ke baad (الْـ) waala lafz aane se 'wahi log hi' (hasr/taakeed) ka mafhoom paida hota hai. Aise Qur'ani jumlon ka tarjuma kijiye:","data":{"text":"Ba'z auqaat (هُمْ) aur jama waale lafz ke darmiyaan koi aur lafz hota hai, ya (هُمْ) ke baad (الْـ) waala lafz aane se 'wahi log hi' (hasr/taakeed) ka mafhoom paida hota hai. Aise Qur'ani jumlon ka tarjuma kijiye:"}},{"type":"section_label","text":"2. هُمْ waale Qur'ani Jumle aur Aayaat (Numbered 1–53)","data":{"text":"2. هُمْ waale Qur'ani Jumle aur Aayaat (Numbered 1–53)"}},{"type":"two_col_numbered_list","is_numbered":true,"data":{"items":[{"id":"s5l5_s_1","arabic":"هُمْ فِيهِ مُخْتَلِفُونَ","hinglish":"Woh iss mein ikhtilaf karne wale hain","sentence_number":1,"translations":{"en":"They are concerning it in disagreement","ur":"وہ اس میں اختلاف کرنے والے ہیں","hi":"वह इसमें इख़्तिलाफ़ करने वाले हैं"},"arabic_markup":"<span class=\"nonroot\">هُمْ</span> <span class=\"arabic-root\">فِيهِ مُخْتَلِفُونَ</span>","displayOrder":13,"ref":"78:3"},{"id":"s5l5_s_2","arabic":"وَهُمْ بِالْآخِرَةِ كَافِرُونَ","hinglish":"Aur woh aakhirat ke munkir hain","sentence_number":2,"translations":{"en":"And they are, concerning the Hereafter, disbelievers","ur":"اور وہ آخرت کے منکر ہیں","hi":"और वह आख़िरत के मुनकिर हैं"},"arabic_markup":"<span class=\"arabic-root\">وَ</span><span class=\"nonroot\">هُمْ</span> <span class=\"arabic-root\">بِالْآخِرَةِ كَافِرُونَ</span>","displayOrder":14,"ref":"7:45"},{"id":"s5l5_s_3","arabic":"وَهُمْ لَهُ مُنْكِرُونَ","hinglish":"Aur woh uske inkar karne wale hain","sentence_number":3,"translations":{"en":"And they are of it unacknowledging","ur":"اور وہ اس کا انکار کرنے والے ہیں","hi":"और वह उसका इनकार करने वाले हैं"},"arabic_markup":"<span class=\"arabic-root\">وَ</span><span class=\"nonroot\">هُمْ</span> <span class=\"arabic-root\">لَهُ مُنْكِرُونَ</span>","displayOrder":15,"ref":"12:58"},{"id":"s5l5_s_4","arabic":"وَهُمْ فِيهَا خَالِدُونَ","hinglish":"Aur woh iss mein hamesha rehne wale hain","sentence_number":4,"translations":{"en":"And they will abide therein eternally","ur":"اور وہ اس میں ہمیشہ رہنے والے ہیں","hi":"और वह इसमें हमेशा रहने वाले हैं"},"arabic_markup":"<span class=\"arabic-root\">وَ</span><span class=\"nonroot\">هُمْ</span> <span class=\"arabic-root\">فِيهَا خَالِدُونَ</span>","displayOrder":16,"ref":"2:25"},{"id":"s5l5_s_5","arabic":"وَهُمْ لَهَا سَابِقُونَ","hinglish":"Aur woh iss ki taraf aage badhne wale hain","sentence_number":5,"translations":{"en":"And they are foremost in them","ur":"اور وہ اس کی طرف آگے بڑھنے والے ہیں","hi":"और वह उसकी तरफ़ आगे बढ़ने वाले हैं"},"arabic_markup":"<span class=\"arabic-root\">وَ</span><span class=\"nonroot\">هُمْ</span> <span class=\"arabic-root\">لَهَا سَابِقُونَ</span>","displayOrder":17,"ref":"23:61"},{"id":"s5l5_s_6","arabic":"وَهُمْ فِيهِ مُبْلِسُونَ","hinglish":"Aur woh iss mein mayoos hain","sentence_number":6,"translations":{"en":"And they will be in despair therein","ur":"اور وہ اس میں مایوس ہوں گے","hi":"और वह इसमें मायूस होंगे"},"arabic_markup":"<span class=\"arabic-root\">وَ</span><span class=\"nonroot\">هُمْ</span> <span class=\"arabic-root\">فِيهِ مُبْلِسُونَ</span>","displayOrder":18,"ref":"43:75"},{"id":"s5l5_s_7","arabic":"وَهُمْ لَهُ نَاصِحُونَ","hinglish":"Aur woh uske khairkhwah hain","sentence_number":7,"translations":{"en":"And they are sincere advisers to him","ur":"اور وہ اس کے خیر خواہ ہیں","hi":"और वह उसके ख़ैरख़्वाह हैं"},"arabic_markup":"<span class=\"arabic-root\">وَ</span><span class=\"nonroot\">هُمْ</span> <span class=\"arabic-root\">لَهُ نَاصِحُونَ</span>","displayOrder":19,"ref":"28:12"},{"id":"s5l5_s_8","arabic":"هُمْ لِلزَّكَاةِ فَاعِلُونَ","hinglish":"Woh zakat ada karne wal