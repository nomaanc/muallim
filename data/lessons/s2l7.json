,"hinglish":"Qur'an ke saath","translations":{"en":"With the Qur'an","ur":"قرآن کے ساتھ","hi":"क़ुरआन के साथ"}},{"id":"s2l7_g3_w28","arabic":"بِالتَّوْرَاةِ","arabic_markup":"<span class=\"nonroot\">بِ</span><span class=\"arabic-root\">التَّوْرَاةِ</span>","hinglish":"Tawrat ke saath","translations":{"en":"With the Torah","ur":"تورات کے ساتھ","hi":"तौरात के साथ"}},{"id":"s2l7_g3_w29","arabic":"بِالْعُمْرَةِ","arabic_markup":"<span class=\"nonroot\">بِ</span><span class=\"arabic-root\">الْعُمْرَةِ</span>","hinglish":"Umrah ke saath","translations":{"en":"With Umrah","ur":"عمرہ کے ساتھ","hi":"उमराह के साथ"}},{"id":"s2l7_g3_w30","arabic":"بِالْعَدْلِ","arabic_markup":"<span class=\"nonroot\">بِ</span><span class=\"arabic-root\">الْعَدْلِ</span>","hinglish":"Adl ke saath","translations":{"en":"With justice","ur":"عدل (انصاف) کے ساتھ","hi":"अद्ल (इंसाफ़) के साथ"}},{"id":"s2l7_g3_w31","arabic":"بِالصَّلَاةِ","arabic_markup":"<span class=\"arabic-root\">بِالصَّلَاةِ</span>","hinglish":"Namaz ke saath","translations":{"en":"With prayer","ur":"نماز کے ساتھ","hi":"नमाज़ के साथ"}},{"id":"s2l7_g3_w32","arabic":"بِالصَّبْرِ","arabic_markup":"<span class=\"arabic-root\">بِالصَّبْرِ</span>","hinglish":"Sabr ke saath","translations":{"en":"With patience","ur":"صبر کے ساتھ","hi":"सब्र के साथ"}},{"id":"s2l7_g3_w33","arabic":"بِالنَّاسِ","arabic_markup":"<span class=\"nonroot\">بِ</span><span class=\"arabic-root\">النَّاسِ</span>","hinglish":"Logon ke saath","translations":{"en":"With the people","ur":"لوگوں کے ساتھ","hi":"लोगों के साथ"}},{"id":"s2l7_g3_w34","arabic":"بِالْبِرِّ","arabic_markup":"<span class=\"nonroot\">بِ</span><span class=\"arabic-root\">الْبِرِّ</span>","hinglish":"Neki ke saath","translations":{"en":"With righteousness","ur":"نیکی کے ساتھ","hi":"नेकी के साथ"}},{"id":"s2l7_g3_w35","arabic":"بِالصِّدْقِ","arabic_markup":"<span class=\"arabic-root\">بِالصِّدْقِ</span>","hinglish":"Sach ke saath","translations":{"en":"With truth","ur":"سچائی کے ساتھ","hi":"सच्चाई के स