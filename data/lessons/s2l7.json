ِ </span><span class=\"nonroot\">وَ</span><span class=\"arabic-root\">النَّهَارِ</span>","hinglish":"Raat aur din ke saath","translations":{"en":"By night and day","ur":"رات اور دن کے ساتھ","hi":"रात और दिन के साथ"}},{"id":"s2l7_g7_w9","arabic":"بِالسُّوءِ وَالْفَحْشَاءِ","arabic_markup":"<span class=\"nonroot\">بِ</span><span class=\"arabic-root\">السُّوءِ </span><span class=\"nonroot\">وَ</span><span class=\"arabic-root\">الْفَحْشَاءِ</span>","hinglish":"Buraai aur be-hayai ke saath","translations":{"en":"With evil and immorality","ur":"برائی اور بے حیائی کے ساتھ","hi":"बुराई और बेहयाई के साथ"}},{"id":"s2l7_g7_w10","arabic":"بِالْبَيِّنَاتِ وَالزُّبُرِ وَالْكِتَابِ","arabic_markup":"<span class=\"nonroot\">بِ</span><span class=\"arabic-root\">الْبَيِّنَاتِ </span><span class=\"nonroot\">وَ</span><span class=\"arabic-root\">الزُّبُرِ </span><span class=\"nonroot\">وَ</span><span class=\"arabic-root\">الْكِتَابِ</span>","hinglish":"Wazeh nishaniyon, saheefon aur kitaab ke saath","translations":{"en":"With clear proofs, scriptures, and the Book","ur":"واضح نشانیوں، صحیفوں اور کتاب کے ساتھ","hi":"वाज़ेह निशानियों, सहीफ़ों और किताब के साथ"},"ref":"3:184"},{"id":"s2l7_g7_w11","arabic":"بِالْحَسَنَاتِ وَالسَّيِّئَاتِ","arabic_markup":"<span class=\"nonroot\">بِ</span><span class=\"arabic-root\">الْحَسَنَاتِ </span><span class=\"nonroot\">وَ</span><span class=\"arabic-root\">السَّيِّئَاتِ</span>","hinglish":"Bhalaion aur buraion ke saath","translations":{"en":"With good things and bad things","ur":"بھلائیوں اور برائیوں کے ساتھ","hi":"भलाइयों और बुराइयों के साथ"}},{"id":"s2l7_g7_w12","arabic":"بِالْغَدَاةِ وَالْعَشِيِّ","arabic_markup":"<span class=\"nonroot\">بِ</span><span class=\"arabic-root\">الْغَدَاةِ </span><span class=\"nonroot\">وَ</span><span class=\"arabic-root\">الْعَشِيِّ</span>","hinglish":"Subah aur shaam ke saath","translations":{"en":"In the morning and the evening","ur":"صبح اور شام","hi":"सुबह और शाम"}}],"cols":3}},{"id":"sec_s2l7_r8","type":"rule_paragraph","data":{"text":"• (بِـ) ka istemaal 'badle mein' (ke liye / meke badle mein) ke liye bhi hota hai. Pehli misaal ki roshni mein darj zail Qur'ani fiqron ko samjhein aur tarjuma kijiye:"}},{"id":"sec_s2l7_g9","type":"two_col_numbered_list","data":{"is_numbered":false,"items":[{"id":"s2l7_g9_w1","arabic":"بِالْأُذُنِ","arabic_markup":"<span class=\"nonroot\">بِ</span><span class=\"arabic-root\">الْأُذُنِ</span>","hinglish":"Kaan ke badle","translations":{"en":"For the ear","ur":"کان کے بدلے","hi":"कान के बदले"}},{"id":"s2l7_g9_w2","arabic":"بِالْأَنْفِ","arabic_markup":"<span class=\"nonroot\">بِ</span><span class=\"arabic-root\">الْأَنْفِ</span>","hinglish":"Naak ke badle","translations":{"en":"For the nose","ur":"ناک کے بدلے","hi":"नाक के बदले"}},{"id":"s2l7_g9_w3","arabic":"بِالْعَيْنِ","arabic_markup":"<span class=\"nonroot\">بِ</span><span class=\"arabic-root\">الْعَيْنِ</span>","hinglish":"Aankh ke badle","translations":{"en":"For the eye","ur":"آنکھ کے بدلے","hi":"आँख के बदले"}},{"id":"s2l7_g9_w4","arabic":"بِالنَّفْسِ","arabic_markup":"<span class=\"nonroot\">بِ</span><span class=\"arabic-root\">النَّفْسِ</span>","hinglish":"Jaan ke badle / jaan se","translations":{"en":"For the life","ur":"جان کے بدلے","hi":"जान के बदले"}},{"id":"s2l7_g9_w5","arabic":"بِالْحُرِّ","arabic_markup":"<span class=\"nonroot\">بِ</span><span class=\"arabic-root\">الْحُرِّ</span>","hinglish":"Azaad ke badle","translations":{"en":"For the free man","ur":"آزاد کے بدلے","hi":"आज़ाद के बदले"}},{"id":"s2l7_g9_w6","arabic":"بِالسِّنِّ","arabic_markup":"<span class=\"nonroot\">بِ</span><span class=\"arabic-root\">السِّنِّ</span>","hinglish":"Daant ke badle (For a tooth)","translations":{"en":"For the tooth","ur":"دانت کے بدلے","hi":"दांत के बदले"}},{"id":"s2l7_g9_w7","arabic":"بِالْأُنْثَى","arabic_markup":"<span class=\"nonroot\">بِ</span><span class=\"arabic-root\">الْأُنْثَى</span>","hinglish":"Aurat ke badle","translations":{"en":"For the female","ur":"عورت کے بدلے","hi":"औरत के बदले"}},{"id":"s2l7_g9_w8","arabic":"بِالْعَبْدِ","arabic_markup":"<span class=\"nonroot\">بِ</span><span class=\"arabic-root\">الْعَبْدِ</span>","hinglish":"Gulaam ke badle","translations":{"en":"For the slave","ur":"غلام کے بدلے","hi":"ग़ुलाम के बदले"}}],"cols":4}},{"id":"sec_s2l7_lbl10","type":"section_label","data":{"text":"Ab aap yeh Qur'ani qanoon khud samajh sakte hain:"}},{"id":"sec_s2l7_v11","type":"two_col_numbered_list","data":{"is_numbered":true,"items":[{"id":"s2l7_v11_s1","sentence_number":1,"arabic":"النَّفْسَ بِالنَّفْسِ / وَالْعَيْنَ بِالْعَيْنِ / وَالْأَنْفَ بِالْأَنْفِ / وَالْأُذُنَ بِالْأُذُنِ / وَالسِّنَّ بِالسِّنِّ","arabic_markup":"<span class=\"arabic-root\">النَّفْسَ</span> <span class=\"nonroot\">بِ</span><span class=\"arabic-root\">النَّفْسِ</span> / <span class=\"nonroot\">وَالْ</span><span class=\"arabic-root\">عَيْنَ</span> <span class=\"arabic-root\">بِالْع</span><span class=\"nonroot\">َيْنِ</span> / <span class=\"nonroot\">وَالْ</span><span class=\"arabic-root\">أَنْفَ</span> <span class=\"nonroot\">بِالْ</span><span class=\"arabic-root\">أَنْفِ</span> / <span class=\"nonroot\">وَالْ</span><span class=\"arabic-root\">أُذُنَ</span> <span class=\"nonroot\">بِالْ</span><span class=\"arabic-root\">أُذُنِ</span> / <span class=\"arabic-root\">وَالسِّنَّ</span> <span class=\"nonroot\">بِ</span><span class=\"arabic-root\">السِّنِّ</span>","hinglish":"Jaan ke badle jaan / aur aankh ke badle aankh / aur naak ke badle naak / aur kaan ke badle kaan / aur daant ke badle daant","translations":{"ur":"جان کے بدلے جان، اور آنکھ کے بدلے آنکھ، اور ناک کے بدلے ناک، اور کان کے بدلے کان، اور دانت کے بدلے دانت","en":"A life for a life, an eye for an eye, a nose for a nose, an ear for an ear, and a tooth for a tooth","hi":"जान के बदले जान, और आँख के बदले आँख, और नाक के बदले नाक, और कान के बदले कान, और दाँत के बदले दाँत"},"ref":"5:45"},{"id":"s2l7_v11_s2","sentence_number":2,"arabic":"الْحُرُّ بِالْحُرِّ / وَالْعَبْدُ بِالْعَبْدِ / وَالْأُنْثَى بِالْأُنْثَى","arabic_markup":"<span class=\"nonroot\">الْ</span><span class=\"arabic-root\">حُرُّ</span> <span class=\"nonroot\">بِالْ</span><span class=\"arabic-root\">حُرِّ</span> / <span class=\"nonroot\">وَالْ</span><span class=\"arabic-root\">عَبْدُ</span> <span class=\"nonroot\">بِالْ</span><span class=\"arabic-root\">عَبْدِ</span> / <span class=\"nonroot\">وَالْ</span><span class=\"arabic-root\">أُنْثَى</span> <span class=\"nonroot\">بِالْ</span><span class=\"arabic-root\">أُنْثَى</span>","hinglish":"Azaad ke badle azaad / aur gulaam ke badle gulaam / aur aurat ke badle aurat","translations":{"ur":"آزاد کے بدلے آزاد، اور غلام کے بدلے غلام، اور عورت کے بدلے عورت","en":"The free for the free, the slave for the slave, and the female for the female","hi":"आज़ाद के बदले आज़ाद, और ग़ुलाम के बदले ग़ुलाम, और औरत के बदले औरत"},"ref":"2:178"}]}},{"id":"sec_s2l7_lbl12","type":"section_label","data":{"text":"Exercise"}},{"id":"sec_s2l7_lbl13","type":"section_label","data":{"text":"Q-1 Darj zail Qur'ani aayaton mein us hisse ko pehchaniye jahan (بِـ) aur agla lafz mil kar woh fiqra banate hain jise aap khud samajh rahe hain:"}},{"id":"sec_s2l7_v14","type":"two_col_numbered_list","data":{"is_numbered":true,"items":[{"id":"s2l7_v14_s1","sentence_number":1,"arabic":"الَّذِينَ يُؤْمِنُونَ بِالْغَيْبِ","arabic_markup":"<span class=\"nonroot\">الَّذِينَ</span> <span class=\"arabic-root\">يُؤْمِن</span><span class=\"nonroot\">ُونَ</span> <span class=\"nonroot\">بِالْ</span><span class=\"arabic-root\">غَيْبِ</span>","hinglish":"Woh jo ghaib par eemaan laate hain","translations":{"ur":"وہ جو غیب پر ایمان لاتے ہیں","en":"Those who believe in the unseen","hi":"वे जो ग़ैब पर ईमान लाते हैं"},"ref":"2:3"},{"id":"s2l7_v14_s2","sentence_number":2,"arabic":"آمَنَّا بِاللَّهِ وَبِالْيَوْمِ الْآخِرِ","arabic_markup":"<span class=\"arabic-root\">آمَنَّا</span> <span class=\"nonroot\">بِ</span><span class=\"arabic-root\">اللَّهِ</span> <span class=\"arabic-root\">وَبِالْيَوْمِ</span> <span class=\"nonroot\">الْ</span><span class=\"arabic-root\">آخِرِ</span>","hinglish":"Hum Allah par aur aakhirat ke din par eemaan laaye","translations":{"ur":"ہم اللہ پر اور آخرت کے دن پر ایمان لائے","en":"We have believed in Allah and the Last Day","hi":"हम अल्लाह पर और आख़िरत के दिन पर ईमान लाए"},"ref":"2:8"},{"id":"s2l7_v14_s3","sentence_number":3,"arabic":"اشْتَرَوُا الضَّلَالَةَ بِالْهُدَى","arabic_markup":"<span class=\"arabic-root\">اشْتَرَوُا</span> <span class=\"arabic-root\">الضَّلَالَةَ</span> <span class=\"nonroot\">بِالْ</span><span class=\"arabic-root\">هُدَى</span>","hinglish":"Unhon ne hidayat ke badle gumraahi khareed li","translations":{"ur":"انہوں نے ہدایت کے بدلے گمراہی خرید لی","en":"They have purchased error in exchange for guidance","hi":"उन्होंने हिदायत के बदले गुमराही ख़रीद ली"}},{"id":"s2l7_v14_s4","sentence_number":4,"arabic":"وَلَا تَلْبِسُوا الْحَقَّ بِالْبَاطِلِ","arabic_markup":"<span class=\"arabic-root\">وَلَا</span> <span class=\"arabic-root\">تَلْبِس</span><span class=\"nonroot\">ُوا</span> <span class=\"nonroot\">الْ</span><span class=\"arabic-root\">حَقَّ</span> <span class=\"nonroot\">بِالْ</span><span class=\"arabic-root\">بَاطِلِ</span>","hinglish":"Aur haq ko baatil ke saath na milao","translations":{"ur":"اور حق کو باطل کے ساتھ نہ ملاؤ","en":"And do not mix the truth with falsehood","hi":"और हक़ को बातिल के साथ न मिलाओ"},"ref":"2:42"},{"id":"s2l7_v14_s5","sentence_number":5,"arabic":"أَتَأْمُرُونَ النَّاسَ بِالْبِرِّ","arabic_markup":"<span class=\"arabic-root\">أَتَأْمُر</span><span class=\"nonroot\">ُونَ</span> <span class=\"arabic-root\">النَّاسَ</span> <span class=\"nonroot\">بِالْ</span><span class=\"arabic-root\">بِرِّ</span>","hinglish":"Kya tum logon ko neki ka hukm dete ho","translations":{"ur":"کیا تم لوگوں کو نیکی کا حکم دیتے ہو؟","en":"Do you order righteousness of the people?","hi":"क्या तुम लोगों को नेकी का हुक्म देते हो?"},"ref":"2:44"},{"id":"s2l7_v14_s6","sentence_number":6,"arabic":"وَاسْتَعِينُوا بِالصَّبْرِ وَالصَّلَاةِ","arabic_markup":"<span class=\"arabic-root\">وَاسْتَعِين</span><span class=\"nonroot\">ُوا</span> <span class=\"nonroot\">بِ</span><span class=\"arabic-root\">الصَّبْرِ</span> <span class=\"arabic-root\">وَالصَّلَاةِ</span>","hinglish":"Aur sabr aur namaz ke zariye madad mango","translations":{"ur":"اور صبر اور نماز کے ذریعے مدد مانگو","en":"And seek help through patience and prayer","hi":"और सब्र और नमाज़ के ज़रिये मदद माँगो"},"ref":"2:45"},{"id":"s2l7_v14_s7","sentence_number":7,"arabic":"الْآنَ جِئْتَ بِالْحَقِّ","arabic_markup":"<span class=\"nonroot\">الْ</span><span class=\"arabic-root\">آنَ</span> <span class=\"arabic-root\">جِئ</span><span class=\"nonroot\">ْتَ</span> <span class=\"nonroot\">بِالْ</span><span class=\"arabic-root\">حَقِّ</span>","hinglish":"Ab tum haq baat le kar aaye ho","translations":{"ur":"اب تم حق بات لے کر آئے ہو","en":"Now you have come with the truth","hi":"अब तुम हक़ बात लेकर आए हो"},"ref":"2:71"},{"id":"s2l7_v14_s8","sentence_number":8,"arabic":"اشْتَرَوُا الْحَيَاةَ الدُّنْيَا بِالْآخِرَةِ","arabic_markup":"<span class=\"arabic-root\">اشْتَرَوُا</span> <span class=\"nonroot\">الْ</span><span class=\"arabic-root\">حَيَاةَ</span> <span class=\"arabic-root\">الدُّنْيَا</span> <span class=\"nonroot\">بِالْ</span><span class=\"arabic-root\">آخِرَةِ</span>","hinglish":"Unhon ne aakhirat ke badle duniya ki zindagi khareed li","translations":{"ur":"انہوں نے آخرت کے بدلے دنیا کی زندگی خرید لی","en":"They have bought the life of this world in exchange for the Hereafter","hi":"उन्होंने आख़िरत के बदले दुनिया की ज़िंदगी ख़रीद ली"},"ref":"2:86"},{"id":"s2l7_v14_s9","sentence_number":9,"arabic":"جَاءَكُمْ مُوسَى بِالْبَيِّنَاتِ","arabic_markup":"<span class=\"arabic-root\">جَاء</span><span class=\"nonroot\">َكُمْ</span> <span class=\"arabic-root\">مُوسَى</span> <span class=\"arabic-root\">بِالْبَيِّن</span><span class=\"nonroot\">َاتِ</span>","hinglish":"Tumhare paas Musa wazeh nishaniyan le kar aaye","translations":{"ur":"تمہارے پاس موسیٰ واضح نشانیاں لے کر آئے","en":"Moses came to you with clear proofs","hi":"तुम्हारे पास मूसा वाज़ेह निशानियाँ लेकर आए"},"ref":"2:92"}],"cols":3}},{"id":"sec_s2l7_lbl15","type":"section_label","data":{"text":"Q-2 (بِـ) ke baad (ال) ki maujoodgi ya ghair-maujoodgi ko dhyan mein rakhte hue, darj zail Qur'ani fiqron ka zubani tarjuma kijiye:"}},{"id":"sec_s2l7_g16","type":"two_col_numbered_list","data":{"is_numbered":false,"items":[{"id":"s2l7_g16_w1","arabic":"بِالْإِيمَانِ","arabic_markup":"<span class=\"arabic-root\">بِالْإِيمَانِ</span>","hinglish":"Eemaan ke saath","translations":{"en":"With faith","ur":"ایمان کے ساتھ","hi":"ईमान के साथ"}},{"id":"s2l7_g16_w2","arabic":"بِالصَّلَاةِ","arabic_markup":"<span class=\"arabic-root\">بِالصَّلَاةِ</span>","hinglish":"Namaz ke saath","translations":{"en":"With prayer","ur":"نماز کے ساتھ","hi":"नमाज़ के साथ"}},{"id":"s2l7_g16_w3","arabic":"بِغَمٍّ","arabic_markup":"<span class=\"arabic-root\">بِغَمٍّ</span>","hinglish":"Kisi gham ke saath","translations":{"en":"With grief","ur":"کسی غم کے ساتھ","hi":"किसी ग़म के साथ"}},{"id":"s2l7_g16_w4","arabic":"بِالْقُرْآنِ","arabic_markup":"<span class=\"arabic-root\">بِالْقُرْآنِ</span>","hinglish":"Qur'an ke saath","translations":{"en":"With the Qur'an","ur":"قرآن کے ساتھ","hi":"क़ुरआन के साथ"}},{"id":"s2l7_g16_w18","arabic":"بِآيَةٍ","arabic_markup":"<span class=\"nonroot\">بِ</span><span class=\"arabic-root\">آيَةٍ</span>","hinglish":"Kisi nishani ke saath","translations":{"en":"With a sign","ur":"کسی نشانی کے ساتھ","hi":"किसी निशानी के साथ"}},{"id":"s2l7_g16_w5","arabic":"بِالْمَغْفِرَةِ","arabic_markup":"<span class=\"arabic-root\">بِالْمَغْفِرَةِ</span>","hinglish":"Maghfeerat ke saath","translations":{"en":"With forgiveness","ur":"مغفرت کے ساتھ","hi":"मग़फ़िरत के साथ"}},{"id":"s2l7_g16_w6","arabic":"بِالشَّرِّ","arabic_markup":"<span class=\"arabic-root\">بِالشَّرِّ</span>","hinglish":"Shar ke saath","translations":{"en":"With evil","ur":"شر (برائی) کے ساتھ","hi":"शर (बुराई) के साथ"}},{"id":"s2l7_g16_w7","arabic":"بِالْأَمْنِ","arabic_markup":"<span class=\"arabic-root\">بِالْأَمْنِ</span>","hinglish":"Amn ke saath","translations":{"en":"With security / peace","ur":"امن کے ساتھ","hi":"अमन के साथ"}},{"id":"s2l7_g16_w8","arabic":"بِخَيْرٍ","arabic_markup":"<span class=\"arabic-root\">بِخَيْرٍ</span>","hinglish":"Kisi bhalai ke saath","translations":{"en":"With good","ur":"کسی بھلائی کے ساتھ","hi":"किसी भलाई के साथ"}},{"id":"s2l7_g16_w9","arabic":"بِالذِّكْرِ","arabic_markup":"<span class=\"arabic-root\">بِالذِّكْرِ</span>","hinglish":"Zikr ke saath","translations":{"en":"With remembrance","ur":"ذکر کے ساتھ","hi":"ज़िक्र के साथ"}},{"id":"s2l7_g16_w10","arabic":"بِالصَّبْرِ","arabic_markup":"<span class=\"arabic-root\">بِالصَّبْرِ</span>","hinglish":"Sabr ke saath","translations":{"en":"With patience","ur":"صبر کے ساتھ","hi":"सब्र के साथ"}},{"id":"s2l7_g16_w11","arabic":"بِغَضَبٍ","arabic_markup":"<span class=\"arabic-root\">بِغَضَبٍ</span>","hinglish":"Kisi gusse ke saath","translations":{"en":"With anger / wrath","ur":"غضب کے ساتھ","hi":"ग़ज़ब के साथ"}},{"id":"s2l7_g16_w12","arabic":"بِنَهَرٍ","arabic_markup":"<span class=\"arabic-root\">بِنَهَرٍ</span>","hinglish":"Kisi nahar ke saath","translations":{"en":"With a river","ur":"کسی نہر کے ساتھ","hi":"किसी नहर के साथ"}},{"id":"s2l7_g16_w13","arabic":"بِدِينَارٍ","arabic_markup":"<span class=\"arabic-root\">بِدِينَارٍ</span>","hinglish":"Kisi denar ke saath","translations":{"en":"With a dinar (gold coin)","ur":"کسی دینار کے بدلے","hi":"किसी दीनार के बदले"}},{"id":"s2l7_g16_w14","arabic":"بِنِعْمَةٍ","arabic_markup":"<span class=\"arabic-root\">بِنِعْمَةٍ</span>","hinglish":"Kisi ne'mat ke saath","translations":{"en":"With a blessing","ur":"کسی نعمت کے ساتھ","hi":"किसी नेमत के साथ"}},{"id":"s2l7_g16_w15","arabic":"بِالصِّدْقِ","arabic_markup":"<span class=\"arabic-root\">بِالصِّدْقِ</span>","hinglish":"Sach ke saath","translations":{"en":"With truthfulness","ur":"سچائی کے ساتھ","hi":"सच्चाई के साथ"}},{"id":"s2l7_g16_w16","arabic":"بِقُوَّةٍ","arabic_markup":"<span class=\"arabic-root\">بِقُوَّةٍ</span>","hinglish":"Kisi quwwat ke saath","translations":{"en":"With strength","ur":"قوت کے ساتھ","hi":"क़ुव्वत के साथ"}},{"id":"s2l7_g16_w17","arabic":"بِشَيْءٍ","arabic_markup":"<span class=\"arabic-root\">بِشَيْءٍ</span>","hinglish":"Kisi cheez ke saath","translations":{"en":"With anything","ur":"کسی چیز کے ساتھ","hi":"किसी चीज़ के साथ"}}],"cols":3}},{"id":"sec_s2l7_g17","type":"grace_box","data":{"text":"Sirf grammar padhne se Qur'an samajh nahi aayega, lekin Qur'an samajhne se Arabi grammar zaroor samajh aa jayegi!"}}]}}