llah","hi":"हुक्म अल्लाह के लिए है"}},{"id":"s2l2_v10_s5","sentence_number":5,"arabic":"الْمُلْكُ/ لِلَّهِ","arabic_markup":"<span class=\"nonroot\">الْ</span><span class=\"arabic-root\">مُلْكُ</span>/ <span class=\"nonroot\">لِ</span><span class=\"arabic-root\">لَّهِ</span>","hinglish":"Badshahat Allah ke liye hai","translations":{"ur":"بادشاہت اللہ کے لیے ہے","en":"The dominion belongs to Allah","hi":"बादशाहत अल्लाह के लिए है"}},{"id":"s2l2_v10_s6","sentence_number":6,"arabic":"الْأَنْفَالُ/ لِلَّهِ","arabic_markup":"<span class=\"nonroot\">الْ</span><span class=\"arabic-root\">أَنْفَالُ</span>/ <span class=\"nonroot\">لِ</span><span class=\"arabic-root\">لَّهِ</span>","hinglish":"Maal-e-ghaneemat Allah ke liye hai","translations":{"ur":"مالِ غنیمت اللہ کے لیے ہے","en":"The bounties of war belong to Allah","hi":"माल-ए-ग़नीमत अल्लाह के लिए है"},"ref":"8:1"},{"id":"s2l2_v10_s7","sentence_number":7,"arabic":"هَذَا/ لِلَّهِ","arabic_markup":"<span class=\"nonroot\">هَذَا</span>/ <span class=\"nonroot\">لِ</span><span class=\"arabic-root\">لَّهِ</span>","hinglish":"Yeh Allah ke liye hai","translations":{"ur":"یہ اللہ کے لیے ہے","en":"This is for Allah","hi":"यह अल्लाह के लिए है"},"ref":"6:136"},{"id":"s2l2_v10_s8","sentence_number":8,"arabic":"وَالْعَاقِبَةُ/ لِلتَّقْوَى","arabic_markup":"<span class=\"nonroot\">وَالْ</span><span class=\"arabic-root\">عَاقِبَةُ</span>/ <span class=\"nonroot\">لِ</span><span class=\"arabic-root\">لتَّقْوَى</span>","hinglish":"Aur anjam taqwa ke liye hai","translations":{"ur":"اور انجام تقویٰ کے لیے ہے","en":"And the best outcome is for righteousness","hi":"और अंजाम तक़वा के लिए है"},"ref":"20:132"},{"id":"s2l2_v10_s9","sentence_number":9,"arabic":"هَذَا بَيَانٌ/ لِلنَّاسِ","arabic_markup":"<span class=\"nonroot\">هَذَا</span> <span class=\"arabic-root\">بَيَانٌ</span>/ <span class=\"nonroot\">لِ</span><span class=\"arabic-root\">لنَّاسِ</span>","hinglish":"Yeh logon ke liye ek wazeh bayan hai","translations":{"ur":"یہ لوگوں کے لیے ایک واضح بیان ہے","en":"This is a clear statement to the people","hi":"यह लोगों के लिए एक वाज़ेह बयान है"},"ref":"3:138"},{"id":"s2l2_v10_s10","sentence_number":10,"arabic":"هَذَا بَلَاغٌ/ لِلنَّاسِ","arabic_markup":"<span class=\"nonroot\">هَذَا</span> <span class=\"arabic-root\">بَلَاغٌ</span>/ <span class=\"nonroot\">لِ</span><span class=\"arabic-root\">لنَّاسِ</span>","hinglish":"Yeh logon ke liye paigham hai","translations":{"ur":"یہ لوگوں کے لیے پیغام ہے","en":"This is a notification for the people","hi":"यह लोगों के लिए पैग़ाम है"},"ref":"14:52"},{"id":"s2l2_v10_s11","sentence_number":11,"arabic":"إِنَّ الْأَرْضَ/ لِلَّهِ","arabic_markup":"<span class=\"nonroot\">إِنَّ</span> <span class=\"nonroot\">الْ</span><span class=\"arabic-root\">أَرْضَ</span>/ <span class=\"nonroot\">لِ</span><span class=\"arabic-root\">لَّهِ</span>","hinglish":"Beshak zameen Allah ke liye hai","translations":{"ur":"بیشک زمین اللہ کے لیے ہے","en":"Indeed, the earth belongs to Allah","hi":"बेशक ज़मीन अल्लाह के लिए है"},"ref":"7:128"},{"id":"s2l2_v10_s12","sentence_number":12,"arabic":"هَذَا بَصَائِرُ/ لِلنَّاسِ","arabic_markup":"<span class=\"nonroot\">هَذَا</span> <span class=\"arabic-root\">بَصَائِرُ</span>/ <span class=\"nonroot\">لِ</span><span class=\"arabic-root\">لنَّاسِ</span>","hinglish":"Yeh logon ke liye nishaniyan hain","translations":{"ur":"یہ لوگوں کے لیے بصیرت کی نشانیاں ہیں","en":"This is enlightenment for the people","hi":"यह लोगों के लिए बसीरत की निशानियाँ हैं"},"ref":"45:20"},{"id":"s2l2_v10_s13","sentence_number":13,"arabic":"فَإِنَّ الْعِزَّةَ/ لِلَّهِ جَمِيعًا","arabic_markup":"<span class=\"arabic-root\">فَإِنَّ</span> <span class=\"nonroot\">الْ</span><span class=\"arabic-root\">عِزَّةَ</span>/ <span class=\"nonroot\">لِ</span><span class=\"arabic-root\">لَّهِ</span> <span class=\"arabic-root\">جَمِيعًا</span>","hinglish":"Phir beshak tamaam izzat Allah ke liye hai","translations":{"ur":"پھر بیشک تمام عزت اللہ کے لیے ہے","en":"Then indeed, to Allah belongs all honor","hi":"फिर बेशक तमाम इज़्ज़त अल्लाह के लिए है"},"ref":"4:139"}]}},{"id":"sec_s2l2_r11","type":"rule_paragraph","data":{"text":"'Lillāh' (لِلَّهِ) aam tor par jumle ke aakhir mein aata hai, lekin kabhi kabhi ta'keed ke liye jumle ke shuru mein bhi aata hai. Iss hisaab se darj zail ibaarat ka tarjuma karein:"}},{"id":"sec_s2l2_v12","type":"two_col_numbered_list","data":{"is_numbered":true,"items":[{"id":"s2l2_v12_s1","sentence_number":1,"arabic":"وَلِلَّهِ/ الْعِزَّةُ","arabic_markup":"<span class=\"arabic-root\">وَلِلَّهِ</span>/ <span class=\"nonroot\">الْ</span><span class=\"arabic-root\">عِزَّةُ</span>","hinglish":"Aur Allah hi ke liye izzat hai","translations":{"ur":"اور اللہ ہی کے لیے عزت ہے","en":"And to Allah belongs all honor","hi":"और अल्लाह ही के लिए इज़्ज़त है"},"ref":"63:8"},{"id":"s2l2_v12_s2","sentence_number":2,"arabic":"لِلَّهِ/ الشَّفَاعَةُ","arabic_markup":"<span class=\"nonroot\">لِ</span><span class=\"arabic-root\">لَّهِ</span>/ <span class=\"arabic-root\">الشَّفَاعَةُ</span>","hinglish":"Allah hi ke liye sifarish hai","translations":{"ur":"اللہ ہی کے لیے سفارش ہے","en":"To Allah belongs intercession","hi":"अल्लाह ही के लिए सिफ़ारिश है"},"ref":"39:44"},{"id":"s2l2_v12_s3","sentence_number":3,"arabic":"وَلِلَّهِ/ الْمَثَلُ","arabic_markup":"<span class=\"arabic-root\">وَلِلَّهِ</span>/ <span class=\"nonroot\">الْ</span><span class=\"arabic-root\">مَثَلُ</span>","hinglish":"Aur Allah hi ke liye aala misaal hai","translations":{"ur":"اور اللہ ہی کے لیے اعلیٰ مثال ہے","en":"And for Allah is the highest attribute","hi":"और अल्लाह ही के लिए आला मिसाल है"},"ref":"16:60"},{"id":"s2l2_v12_s4","sentence_number":4,"arabic":"لِلَّهِ/ الْأَمْرُ جَمِيعًا","arabic_markup":"<span class=\"nonroot\">لِ</span><span class=\"arabic-root\">لَّهِ</span>/ <span class=\"nonroot\">الْ</span><span class=\"arabic-root\">أَمْرُ</span> <span class=\"arabic-root\">جَمِيعًا</span>","hinglish":"Allah hi ke liye tamaam hukm hai","translations":{"ur":"اللہ ہی کے لیے تمام حکم ہے","en":"To Allah belongs the command completely","hi":"अल्लाह ही के लिए तमाम हुक्म है"},"ref":"13:31"},{"id":"s2l2_v12_s5","sentence_number":5,"arabic":"لِلَّهِ/ الدِّينُ","arabic_markup":"<span class=\"nonroot\">لِ</span><span class=\"arabic-root\">لَّهِ</span>/ <span class=\"arabic-root\">الدِّينُ</span>","hinglish":"Allah hi ke liye deen hai","translations":{"ur":"اللہ ہی کے لیے دین ہے","en":"To Allah belongs the religion","hi":"अल्लाह ही के लिए दीन है"},"ref":"39:3"},{"id":"s2l2_v12_s6","sentence_number":6,"arabic":"وَلِلَّهِ/ الْمَشْرِقُ وَالْمَغْرِبُ","arabic_markup":"<span class=\"arabic-root\">وَلِلَّهِ</span>/ <span class=\"nonroot\">الْ</span><span class=\"arabic-root\">مَشْرِقُ</span> <span class=\"nonroot\">وَالْ</span><span class=\"arabic-root\">مَغْرِبُ</span>","hinglish":"Aur Allah hi ke liye mashriq aur maghrib hai","translations":{"ur":"اور اللہ ہی کے لیے مشرق اور مغرب ہے","en":"And to Allah belongs the east and the west","hi":"और अल्लाह ही के लिए मशरिक़ और मग़रिब है"},"ref":"2:115"}],"cols":3}},{"id":"sec_s2l2_r13","type":"rule_paragraph","data":{"text":"Agar 'Fa' (فَ) 'Lillāh' ke shuru mein ho, toh 'Fa-Lillāh' ka matlab hai 'Toh sirf Allah ke liye' ya 'Phir Allah hi ke liye'. Iss baat ko zehn mein rakh kar darj zail ibaarat ka tarjuma karein:"}},{"id":"sec_s2l2_v14","type":"two_col_numbered_list","data":{"is_numbered":true,"items":[{"id":"s2l2_v14_s1","sentence_number":1,"arabic":"فَلِلَّهِ/ الْعِزَّةُ","arabic_markup":"<span class=\"arabic-root\">فَلِلَّهِ</span>/ <span class=\"nonroot\">الْ</span><span class=\"arabic-root\">عِزَّةُ</span>","hinglish":"Phir Allah hi ke liye izzat hai","translations":{"ur":"پھر اللہ ہی کے لیے عزت ہے","en":"Then to Allah belongs all honor","hi":"फिर अल्लाह ही के लिए इज़्ज़त है"},"ref":"35:10"},{"id":"s2l2_v14_s2","sentence_number":2,"arabic":"فَلِلَّهِ/ الْحَمْدُ","arabic_markup":"<span class=\"arabic-root\">فَلِلَّهِ</span>/ <span class=\"nonroot\">الْ</span><span class=\"arabic-root\">حَمْدُ</span>","hinglish":"Phir Allah hi ke liye tamaam tareef hai","translations":{"ur":"پھر اللہ ہی کے لیے تمام تعریف ہے","en":"Then to Allah belongs all praise","hi":"फिर अल्लाह ही के लिए तमाम तारीफ़ है"},"ref":"45:36"},{"id":"s2l2_v14_s3","sentence_number":3,"arabic":"فَلِلَّهِ/ الْحُجَّةُ","arabic_markup":"<span class=\"arabic-root\">فَلِلَّهِ</span>/ <span class=\"nonroot\">الْ</span><span class=\"arabic-root\">حُجَّةُ</span>","hinglish":"Phir Allah hi ke liye kaamil daleel hai","translations":{"ur":"پھر اللہ ہی کے لیے کامل دلیل ہے","en":"Then with Allah is the far-reaching argument","hi":"फिर अल्लाह ही के लिए कामिल दलील है"},"ref":"6:149"},{"id":"s2l2_v14_s4","sentence_number":4,"arabic":"فَلِلَّهِ/ الْمَكْرُ","arabic_markup":"<span class=\"arabic-root\">فَلِلَّهِ</span>/ <span class=\"nonroot\">الْ</span><span class=\"arabic-root\">مَكْرُ</span>","hinglish":"Phir Allah hi ke liye tamaam tadbeer hai","translations":{"ur":"پھر اللہ ہی کے لیے تمام تدبیر ہے","en":"Then to Allah belongs the plan","hi":"फिर अल्लाह ही के लिए तमाम तदबीर है"},"ref":"13:42"},{"id":"s2l2_v14_s5","sentence_number":5,"arabic":"فَلِلَّهِ/ الْمَكْرُ جَمِيعًا","arabic_markup":"<span class=\"arabic-root\">فَلِلَّهِ</span>/ <span class=\"nonroot\">الْ</span><span class=\"arabic-root\">مَكْرُ</span> <span class=\"arabic-root\">جَمِيعًا</span>","hinglish":"Phir Allah hi ke liye tamaam tadbeerein hain","translations":{"ur":"پھر اللہ ہی کے لیے تمام تدبیریں ہیں","en":"Then to Allah belongs all planning","hi":"फिर अल्लाह ही के लिए तमाम तदबीरें हैं"},"ref":"13:42"},{"id":"s2l2_v14_s6","sentence_number":6,"arabic":"فَلِلَّهِ/ الْآخِرَةُ وَالْأُولَى","arabic_markup":"<span class=\"arabic-root\">فَلِلَّهِ</span>/ <span class=\"nonroot\">الْ</span><span class=\"arabic-root\">آخِرَةُ</span> <span class=\"nonroot\">وَالْ</span><span class=\"arabic-root\">أُولَى</span>","hinglish":"Phir Allah hi ke liye aakhirat aur duniya hai","translations":{"ur":"پھر اللہ ہی کے لیے آخرت اور دنیا ہے","en":"Then to Allah belongs the Hereafter and the first life","hi":"फिर अल्लाह ही के लिए आख़िरत और दुनिया है"},"ref":"53:25"}],"cols":3}},{"type":"section_label","data":{"text":"Exercise Q-1 (Page 55): Darj zail Qur'ani jumlon mein (لِـ) wale murakkab ko pehchaniye:","title":"Exercise Q-1 (Page 55)"}},{"type":"two_col_numbered_list","data":{"cols":2,"is_numbered":true,"items":[{"id":"s2l2_ex1_s1","arabic":"﴿وَالَّذِينَ هُمْ لِلزَّكَاةِ فَاعِلُونَ﴾","arabic_markup":"﴿<span class=\"nonroot\">وَالَّذِينَ هُمْ لِ</span><span class=\"arabic-root\">لزَّكَاةِ فَاعِلُونَ</span>﴾","hinglish":"Aur woh log jo zakaat ada karne wale hain","translations":{"en":"And they who are observant of zakah","ur":"اور وہ لوگ جو زکوٰۃ ادا کرنے والے ہیں","hi":"और वे लोग जो ज़कात अदा करने वाले हैं"},"sentence_number":1,"displayOrder":1,"ref":"23:4"},{"id":"s2l2_ex1_s2","arabic":"﴿وَأَنْ لَيْسَ لِلْإِنْسَانِ إِلَّا مَا سَعَىٰ﴾","arabic_markup":"﴿<span class=\"nonroot\">وَأَنْ لَيْسَ لِ</span><span class=\"arabic-root\">لْإِنْسَانِ</span> <span class=\"nonroot\">إِلَّا مَا سَعَىٰ</span>﴾","hinglish":"Aur yeh ke insaan ke liye wahi hai jiski usne koshish ki","translations":{"en":"And that there is not for man except that for which he strives","ur":"اور یہ کہ انسان کے لیے وہی ہے جس کی اس نے کوشش کی","hi":"और यह कि इंसान के लिए वही है जिसकी उसने कोशिश की"},"sentence_number":2,"displayOrder":2,"ref":"53:39"},{"id":"s2l2_ex1_s3","arabic":"﴿لَا تَسْجُدُوا لِلشَّمْسِ وَلَا لِلْقَمَرِ﴾","arabic_markup":"﴿<span class=\"nonroot\">لَا تَسْجُدُوا لِ</span><span class=\"arabic-root\">لشَّمْسِ</span> <span class=\"nonroot\">وَلَا لِ</span><span class=\"arabic-root\">لْقَمَرِ</span>﴾","hinglish":"Suraj ko sajda na karo aur na chaand ko","translations":{"en":"Do not prostrate to the sun or to the moon","ur":"سورج کو سجدہ نہ کرو اور نہ چاند کو","hi":"सूरज को सज्दा न करो और न चाँद को"},"sentence_number":3,"displayOrder":3,"ref":"41:37"},{"id":"s2l2_ex1_s4","arabic":"﴿إِنِّي نَذَرْتُ لِلرَّحْمَٰنِ صَوْمًا﴾","arabic_markup":"﴿<span class=\"nonroot\">إِنِّي نَذَرْتُ لِ</span><span class=\"arabic-root\">لرَّحْمَٰنِ صَوْمًا</span>﴾","hinglish":"Beshak maine Rahman ke liye roze ki mannat maani hai","translations":{"en":"Indeed, I have vowed to the Most Merciful a fast","ur":"بیشک میں نے رحمٰن کے لیے روزے کی نذر مانی ہے","hi":"बेशक मैंने रहमान के लिए रोज़े की मन्नत मानी है"},"sentence_number":4,"displayOrder":4,"ref":"19:26"},{"id":"s2l2_ex1_s5","arabic":"﴿وَفِي أَمْوَالِهِمْ حَقٌّ لِلسَّائِلِ وَالْمَحْرُومِ﴾","arabic_markup":"﴿<span class=\"nonroot\">وَفِي</span> <span class=\"arabic-root\">أَمْوَالِهِمْ حَقٌّ لِلسَّائِلِ وَالْمَحْرُومِ</span>﴾","hinglish":"Aur unke maalon mein maangne wale aur mahroom ke liye haq hai","translations":{"en":"And from their properties was given the right of the petitioner and the deprived","ur":"اور ان کے مالوں میں مانگنے والے اور محروم کے لیے حق ہے","hi":"और उनके मालों में माँगने वाले और महरूम के लिए हक़ है"},"sentence_number":5,"displayOrder":5,"ref":"51:19"},{"id":"s2l2_ex1_s6","arabic":"﴿إِنَّ الشَّيْطَانَ لِلْإِنْسَانِ عَدُوٌّ مُبِينٌ﴾","arabic_markup":"﴿<span class=\"nonroot\">إِنَّ</span> <span class=\"arabic-root\">الشَّيْطَانَ لِلْإِنْسَانِ عَدُوٌّ مُبِينٌ</span>﴾","hinglish":"Beshak Shaytan insaan ke liye khula dushman hai","translations":{"en":"Indeed Satan, to man, is a manifest enemy","ur":"بیشک شیطان انسان کے لیے کھلا دشمن ہے","hi":"बेशक शैतान इंसान के लिए खुला दुश्मन है"},"sentence_number":6,"displayOrder":6,"ref":"12:5"},{"id":"s2l2_ex1_s7","arabic":"﴿لَا تُبْقِي وَلَا تَذَرُ . لَوَّاحَةٌ لِلْبَشَرِ﴾","arabic_markup":"﴿<span class=\"nonroot\">لَا تُبْقِي وَلَا تَذَرُ . لَوَّاحَةٌ لِ</span><span class=\"arabic-root\">لْبَشَرِ</span>﴾","hinglish":"Na woh baqi chhorti hai aur na chhodti hai, insaan ki khaal jhulsa dene wali hai","translations":{"en":"It lets nothing remain and leaves nothing, scorching the skin of man","ur":"نہ وہ باقی چھوڑتی ہے اور نہ رکتی ہے، انسان کی کھال جھلسا دینے والی ہے","hi":"न वह बाक़ी छोड़ती है और न रुकती है, इंसान की खाल झुलसा देने वाली है"},"sentence_number":7,"displayOrder":7,"ref":"74:28-29"},{"id":"s2l2_ex1_s8","arabic":"﴿أَوْقِدُوا نَارًا لِلْحَرْبِ﴾","arabic_markup":"﴿<span class=\"nonroot\">أَوْقِدُوا</span> <span class=\"arabic-root\">نَارًا لِلْحَرْبِ</span>﴾","hinglish":"Unhon ne jang ke liye aag bhadkayi","translations":{"en":"They kindled a fire for war","ur":"انہوں نے جنگ کے لیے آگ بھڑکائی","hi":"उन्होंने जंग के लिए आग भड़काई"},"sentence_number":8,"displayOrder":8,"ref":"5:64"}]}},{"id":"sec_s2l2_lbl15","type":"section_label","data":{"text":"Exercise — Q-2: Darj zail Qur'ani tarakeeb jo (لِـ) se bani hain, unka zabani tarjuma karein:"}},{"id":"sec_s2l2_exg16","type":"two_col_numbered_list","data":{"is_numbered":false,"items":[{"id":"s2l2_exg16_w1","arabic":"لِلْقِتَالِ","arabic_markup":"<span class=\"nonroot\">لِ</span><span class=\"arabic-root\">لْقِتَالِ</span>","hinglish":"Jung ke liye","translations":{"en":"For fighting","ur":"قتال (جنگ) کے لیے","hi":"क़िताल (जंग) के लिए"}},{"id":"s2l2_exg16_w2","arabic":"لِلْحَرْبِ","arabic_markup":"<span class=\"nonroot\">لِ</span><span class=\"arabic-root\">لْحَرْبِ</span>","hinglish":"Larai ke liye","translations":{"en":"For war","ur":"جنگ کے لیے","hi":"जंग के लिए"}},{"id":"s2l2_exg16_w3","arabic":"لِلْخَيْرِ","arabic_markup":"<span class=\"nonroot\">لِ</span><span class=\"arabic-root\">لْخَيْرِ</span>","hinglish":"Bhalai ke liye","translations":{"en":"For good","ur":"بھلائی کے لیے","hi":"भलाई के लिए"}},{"id":"s2l2_exg16_w4","arabic":"لِلنَّاسِ","arabic_markup":"<span class=\"nonroot\">لِ</span><span class=\"arabic-root\">لنَّاسِ</span>","hinglish":"Logon ke liye","translations":{"en":"For the people","ur":"لوگوں کے لیے","hi":"लोगों के लिए"}},{"id":"s2l2_exg16_w5","arabic":"لِلْكَذِبِ","arabic_markup":"<span class=\"nonroot\">لِ</span><span class=\"arabic-root\">لْكَذِبِ</span>","hinglish":"Jhooth ke liye","translations":{"en":"For falsehood / lying","ur":"جھوٹ کے لیے","hi":"झूठ के लिए"}},{"id":"s2l2_exg16_w6","arabic":"لِلْكُفْرِ","arabic_markup":"<span class=\"nonroot\">لِ</span><span class=\"arabic-root\">لْكُفْرِ</span>","hinglish":"Kufr ke liye","translations":{"en":"For disbelief","ur":"کفر کے لیے","hi":"कुफ़्र के लिए"}},{"id":"s2l2_exg16_w7","arabic":"لِلتَّقْوَى","arabic_markup":"<span class=\"nonroot\">لِ</span><span class=\"arabic-root\">لتَّقْوَى</span>","hinglish":"Taqwa ke liye","translations":{"en":"For piety (taqwa)","ur":"تقویٰ کے لیے","hi":"तक़वा के लिए"}},{"id":"s2l2_exg16_w8","arabic":"لِلْحَقِّ","arabic_markup":"<span class=\"nonroot\">لِ</span><span class=\"arabic-root\">لْحَقِّ</span>","hinglish":"Haq ke liye","translations":{"en":"For the truth","ur":"حق کے لیے","hi":"हक़ के लिए"}},{"id":"s2l2_exg16_w9","arabic":"لِلدِّينِ","arabic_markup":"<span class=\"nonroot\">لِ</span><span class=\"arabic-root\">لدِّينِ</span>","hinglish":"Deen ke liye","translations":{"en":"For the religion","ur":"دین کے لیے","hi":"दीन के लिए"}},{"id":"s2l2_exg16_w10","arabic":"لِلْكِتَابِ","arabic_markup":"<span class=\"nonroot\">لِ</span><span class=\"arabic-root\">لْكِتَابِ</span>","hinglish":"Kitaab ke liye","translations":{"en":"For the Book","ur":"کتاب کے لیے","hi":"किताब के लिए"}},{"id":"s2l2_exg16_w11","arabic":"لِلْقَوْمِ","arabic_markup":"<span class=\"nonroot\">لِ</span><span class=\"arabic-root\">لْقَوْمِ</span>","hinglish":"Qaum ke liye","translations":{"en":"For the people / nation","ur":"قوم کے لیے","hi":"क़ौम के लिए"}},{"id":"s2l2_exg16_w12","arabic":"لِلسَّاعَةِ","arabic_markup":"<span class=\"nonroot\">لِ</span><span class=\"arabic-root\">لسَّاعَةِ</span>","hinglish":"Qayamat ke liye","translations":{"en":"For the Hour (Judgment)","ur":"قیامت کی گھڑی کے لیے","hi":"क़ियामत की घड़ी के लिए"}},{"id":"s2l2_exg16_w13","arabic":"لِلصَّلَاةِ","arabic_markup":"<span class=\"nonroot\">لِ</span><span class=\"arabic-root\">لصَّلَاةِ</span>","hinglish":"Namaz ke liye","translations":{"en":"For the prayer","ur":"نماز کے لیے","hi":"नमाज़ के लिए"}},{"id":"s2l2_exg16_w14","arabic":"لِلْغَيْبِ","arabic_markup":"<span class=\"nonroo