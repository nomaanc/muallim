# ==============================================================================
# MUALLIM UL-QUR'AN — ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env or .env.local and populate secrets
# ==============================================================================

# 1. FIREBASE WEB API CONFIGURATION
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_API_KEY="your-api-key"
FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
FIREBASE_APP_ID="your-app-id"

# 2. DEPLOYMENT & HOSTING CONFIGURATION
FIREBASE_HOSTING_URL="https://your-project.web.app"
FIREBASE_APP_URL="https://your-project.firebaseapp.com"
FIREBASE_DEPLOY_PROJECT="your-project-id"
FIREBASE_TOKEN=""
GOOGLE_APPLICATION_CREDENTIALS=""

# 3. GITHUB REPOSITORY & DEPLOYMENT SETTINGS
GITHUB_OWNER="nomaanc"
GITHUB_REPO="muallim"
GITHUB_REPOSITORY="nomaanc/muallim"
GITHUB_DEFAULT_BRANCH="main"
GITHUB_PAGES_URL="https://nomaanc.github.io/muallim/"
GITHUB_TOKEN=""

# 4. APPLICATION METADATA & CACHE SETTINGS
APP_ENV="production"
APP_NAME="Muallim ul-Qur'an"
APP_VERSION="5.1.0"
CACHE_NAME="muallim-v5.1.0-cache"
PORT="8080"
HOST="localhost"
