rules_version = '2';

// ===============================================================
// Assumed Data Model (Muallim ul-Qur'an PWA v7.0 — Student-Only)
// ===============================================================
//
// Collection: user_data
// Document ID: {userId} (Firebase Auth UID — strictly owner-only)
// Fields (all optional on partial merge writes; at least 1 allowed field required):
//   - uid: string (optional, must equal document userId, immutable once set)
//   - name: string (optional, 0-100 chars)
//   - deviceId: string (optional, 1-128 chars)
//   - role: string (optional, 'student' or 'guest' only — never privileged)
//   - preferredLang: string (optional, 1-16 chars)
//   - theme: string (optional, 'parchment', 'night', 'sepia', 'light', or 'dark')
//   - currentStage: int (optional, 1..7)
//   - currentLesson: int (optional, 1..30)
//   - streak: map (optional, max 10 keys — daily study streak state)
//   - completedLessons: map (optional, max 200 entries — completed lesson map)
//   - studyLog: map (optional, max 400 entries — daily YYYY-MM-DD activity counts)
//   - starredItems: list (optional, max 2500 items)
//   - starred: list (optional, max 2500 items — legacy alias)
//   - customTranslations: map (optional, max 2500 entries)
//   - customAnswers: map (optional, max 2500 entries — legacy alias)
//   - lastBookmark: map or null (optional, max 10 keys)
//   - bookmark: map or null (optional, max 10 keys — legacy alias)
//   - lessonTime: map (optional, max 200 entries)
//   - lessonProgress: map (optional, max 200 entries)
//   - srs: map (optional, max 12000 entries — spaced-repetition state)
//   - last_srs_sync: timestamp (optional)
//   - weakWords: map (optional, max 5000 entries)
//   - examHistory: list (optional, max 200 entries)
//   - examResults: list (optional, max 200 entries — legacy alias)
//   - mergedFromGuest: string (optional, 1-128 chars)
//   - deletedItems: map (optional, max 5000 entries — deletion tombstones keyed by item/lesson ID with timestamp numbers)
//   - fieldUpdatedAt: map (optional, max 50 entries — per-field sync timestamps)
//   - createdAt: timestamp (optional, immutable once set)
//   - lastSeen: timestamp (optional)
//   - updatedAt: timestamp (optional)
//
// All other collections (/users, /pushed_exams, /exam_results,
// /guest_data, /muallim_students, /muallim_broadcasts, etc.) are
// removed and denied by default.
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ─────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function uidUnchanged(userId) {
      return !('uid' in request.resource.data)
        || (request.resource.data.uid is string
            && request.resource.data.uid == userId
            && request.resource.data.uid == request.auth.uid);
    }

    function uidNotModified() {
      return !('uid' in resource.data)
        || (('uid' in request.resource.data)
            && request.resource.data.uid == resource.data.uid);
    }

    function createdAtNotModified() {
      return !('createdAt' in resource.data)
        || (('createdAt' in request.resource.data)
            && request.resource.data.createdAt == resource.data.createdAt);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function isValidOptionalString(data, field, minLen, maxLen) {
      return !(field in data)
        || (data[field] is string
            && data[field].size() >= minLen
            && data[field].size() <= maxLen);
    }

    function isValidOptionalList(data, field, maxSize) {
      return !(field in data)
        || (data[field] is list && data[field].size() <= maxSize);
    }

    function isValidOptionalMap(data, field, maxSize) {
      return !(field in data)
        || (data[field] is map && data[field].size() <= maxSize);
    }

    function isValidOptionalNullableMap(data, field, maxSize) {
      return !(field in data)
        || data[field] == null
        || (data[field] is map && data[field].size() <= maxSize);
    }

    function isValidOptionalTimestamp(data, field) {
      return !(field in data) || data[field] is timestamp;
    }

    // ── Domain Validator (applied on BOTH create and update) ─────
    function isValidUserData(data, userId) {
      let allowedFields = [
        'uid',
        'name',
        'deviceId',
        'role',
        'preferredLang',
        'theme',
        'currentStage',
        'currentLesson',
        'starredItems',
        'starred',
        'customTranslations',
        'customAnswers',
        'lastBookmark',
        'bookmark',
        'lessonTime',
        'lessonProgress',
        'srs',
        'last_srs_sync',
        'weakWords',
        'examHistory',
        'examResults',
        'mergedFromGuest',
        'streak',
        'completedLessons',
        'studyLog',
        'deletedItems',
        'fieldUpdatedAt',
        'createdAt',
        'lastSeen',
        'updatedAt'
      ];
      return data.keys().size() >= 1
        && hasOnlyAllowedFields(allowedFields)
        && uidUnchanged(userId)
        && isValidOptionalString(data, 'name', 0, 100)
        && isValidOptionalString(data, 'deviceId', 1, 128)
        && (!('role' in data) || (data.role is string && data.role in ['student', 'guest']))
        && isValidOptionalString(data, 'preferredLang', 1, 16)
        && (!('theme' in data) || (data.theme is string && data.theme in ['parchment', 'night', 'sepia', 'light', 'dark']))
        && (!('currentStage' in data) || (data.currentStage is int && data.currentStage >= 1 && data.currentStage <= 7))
        && (!('currentLesson' in data) || (data.currentLesson is int && data.currentLesson >= 1 && data.currentLesson <= 30))
        && isValidOptionalMap(data, 'streak', 10)
        && isValidOptionalMap(data, 'completedLessons', 200)
        && isValidOptionalMap(data, 'studyLog', 400)
        && isValidOptionalList(data, 'starredItems', 2500)
        && isValidOptionalList(data, 'starred', 2500)
        && isValidOptionalMap(data, 'customTranslations', 2500)
        && isValidOptionalMap(data, 'customAnswers', 2500)
        && isValidOptionalNullableMap(data, 'lastBookmark', 10)
        && isValidOptionalNullableMap(data, 'bookmark', 10)
        && isValidOptionalMap(data, 'lessonTime', 200)
        && isValidOptionalMap(data, 'lessonProgress', 200)
        && isValidOptionalMap(data, 'srs', 12000)
        && isValidOptionalTimestamp(data, 'last_srs_sync')
        && isValidOptionalMap(data, 'weakWords', 5000)
        && isValidOptionalList(data, 'examHistory', 200)
        && isValidOptionalList(data, 'examResults', 200)
        && isValidOptionalString(data, 'mergedFromGuest', 1, 128)
        && isValidOptionalMap(data, 'deletedItems', 5000)
        && isValidOptionalMap(data, 'fieldUpdatedAt', 50)
        && isValidOptionalTimestamp(data, 'createdAt')
        && isValidOptionalTimestamp(data, 'lastSeen')
        && isValidOptionalTimestamp(data, 'updatedAt');
    }

    // ── User Data (/user_data/{userId}) ──────────────────────────
    // Strictly owner-only read/write with schema validation on create and update.
    match /user_data/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && isValidUserData(request.resource.data, userId);
      allow update: if isOwner(userId)
        && isValidUserData(request.resource.data, userId)
        && uidNotModified()
        && createdAtNotModified();
      allow delete: if isOwner(userId);
    }

    // ── Default Deny: all other paths ────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
