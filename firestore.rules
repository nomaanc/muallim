rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: users
// Document ID: {uid} (Firebase Auth UID)
// Fields:
//   - email: string (required) - user email address
//   - name: string (required, max 100) - display name
//   - role: string (required) - 'admin' or 'student' (immutable by self)
//   - createdAt: timestamp (required, immutable)
//   - lastLogin: timestamp (optional)
//
// Collection: user_data
// Document ID: {uid} (Firebase Auth UID)
// Fields:
//   - starred: array (optional) - starred item IDs
//   - customAnswers: map (optional) - custom answer overrides
//   - bookmark: map (optional) - { stage, lesson, section }
//   - lessonProgress: map (optional)
//   - examResults: array (optional)
//
// Collection: pushed_exams
// Document ID: {examId}
// Fields:
//   - title: string (required)
//   - questions: array (required)
//   - pushedAt: timestamp (required)
//   - pushedBy: string (required) - admin UID
//
// Collection: exam_results/{examId}/{studentId}
// Document ID: {studentId} (Firebase Auth UID)
// Fields:
//   - score: number (required)
//   - answers: array (required)
//   - submittedAt: timestamp (required)
//   - uid: string (required, immutable) - must match studentId
//
// Collection: muallim_students (LEGACY — device UUID based)
// Document ID: {deviceId}
// Fields:
//   - deviceId: string (required, immutable, max 100)
//   - name: string (required, max 100)
//   - [other legacy fields]
//
// Collection: muallim_broadcasts (LEGACY)
// Document ID: {broadcastId}
// Fields:
//   - message: string (required, 1-500 chars)
//   - sentAt: timestamp (required)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ───────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }
    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }
    function validStringLength(field, minLen, maxLen) {
      return request.resource.data[field] is string
        && request.resource.data[field].size() >= minLen
        && request.resource.data[field].size() <= maxLen;
    }
    // Ensure the 'role' field is not being set/changed by a non-admin self-update
    function roleNotModified() {
      return !('role' in request.resource.data)
        || request.resource.data.role == resource.data.role;
    }

    // ── User profiles ──────────────────────────────────────────
    // - Only owner or admin can read
    // - Only admin can create (users created by admin on first login)
    // - Owner can update (but CANNOT change their own role — prevents privilege escalation)
    // - Only admin can delete
    match /users/{userId} {
      allow read:   if isOwner(userId) || isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin()
                    || (isOwner(userId) && roleNotModified());
      allow delete: if isAdmin();
    }

    // ── User data (starred, customAnswers, bookmark, progress) ─
    // Only owner or admin can read/write
    match /user_data/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // ── Teacher-pushed exams ───────────────────────────────────
    // Any authenticated user can read; only admin can write
    match /pushed_exams/{examId} {
      allow read:                   if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // ── Exam results ───────────────────────────────────────────
    // Student can read/create own result; admin can read/update/delete all
    match /exam_results/{examId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();

      match /submissions/{studentId} {
        allow read:   if isOwner(studentId) || isAdmin();
        allow create, update: if isOwner(studentId) || isAdmin();
        allow delete: if isAdmin();
      }
    }
    match /exam_results/{examId}/{studentId} {
      allow read:   if isOwner(studentId) || isAdmin();
      allow create, update: if isOwner(studentId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ── Guest data collection (anonymous user cloud sync) ────────
    match /guest_data/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // ── Legacy: muallim_students (device-based) ────────────────
    // Authenticated read; write only with valid self-referential deviceId + name fields
    match /muallim_students/{deviceId} {
      allow read: if isAuthenticated() || isAdmin();
      allow write: if
        request.resource.data.deviceId == deviceId
        && request.resource.data.keys().hasAll(['deviceId', 'name'])
        && request.resource.data.deviceId is string
        && validStringLength('name', 1, 100);
    }

    // ── Legacy: broadcast messages ─────────────────────────────
    // Authenticated read; only ADMINS can create broadcasts (prevents anonymous spam)
    // Admin can delete broadcasts
    match /muallim_broadcasts/{broadcastId} {
      allow read: if isAuthenticated() || isAdmin();
      allow create: if isAdmin()
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 500;
      allow update, delete: if isAdmin();
    }

    // ── Default: deny all other paths ─────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}