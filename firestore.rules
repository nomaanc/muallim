rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -- Helper functions
    function isAuthed() {
      return request.auth != null;
    }
    function isAdmin() {
      return isAuthed() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isOwner(uid) {
      return isAuthed() && request.auth.uid == uid;
    }

    // -- User profiles
    match /users/{userId} {
      allow read:   if isOwner(userId) || isAdmin();
      allow create: if isAdmin();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // -- User data (starred, customAnswers, bookmark, progress)
    match /user_data/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // -- Teacher-pushed exams
    match /pushed_exams/{examId} {
      allow read:                   if isAuthed();
      allow create, update, delete: if isAdmin();
    }

    // -- Exam results
    match /exam_results/{examId}/{studentId} {
      allow read:   if isOwner(studentId) || isAdmin();
      allow create: if isOwner(studentId);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // -- Legacy: muallim_students (device-based, keep open)
    match /muallim_students/{deviceId} {
      allow read: if true;
      allow write: if
        request.resource.data.deviceId == deviceId
        && request.resource.data.keys().hasAll(['deviceId', 'name'])
        && request.resource.data.deviceId is string
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100;
    }

    // -- Legacy: broadcast messages
    match /muallim_broadcasts/{broadcastId} {
      allow read: if true;
      allow create: if
        request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 500
        && request.resource.data.keys().hasAll(['message', 'sentAt']);
      allow update, delete: if false;
    }

    // -- Default: deny all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
