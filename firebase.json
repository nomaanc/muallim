{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "scratch/**",
      "functions/**",
      "firestore.rules",
      "firestore.indexes.json",
      "*.py",
      "*.txt",
      "*.md",
      "book_data.js",
      "book_data.json",
      "pwa_book_data.js",
      "app.js",
      "styles.css",
      "html-update.md",
      "feature-enhancements-prompt.md",
      "data-audit-prompt.md",
      "final-book-7units.html",
      "package.json",
      "package-lock.json",
      "playwright.config.js",
      "tests/**",
      "test-results/**",
      "data/da_audit_log.json"
    ],
    "rewrites": [
      { "source": "**", "destination": "/index.html" }
    ]
  }
}
