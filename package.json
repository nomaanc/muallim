{
  "name": "muallim-pwa",
  "version": "7.0.0",
  "type": "module",
  "description": "Muallim ul-Qur'an offline-first Arabic workbook PWA (vanilla ES modules; devDependencies used strictly for Playwright E2E tests)",
  "private": true,
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "test:unit": "node --test tests/unit/*.test.js",
    "test:e2e": "playwright test",
    "test": "node --test tests/unit/*.test.js && playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nomaanc/muallim.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
